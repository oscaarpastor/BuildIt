<!DOCTYPE html>
<html <%- htmlAttrs %>>
<head>
  <%- head %>
  <style>
    /* Boda: editorial romántica, como una papelería de invitación. Cormorant
       Garamond ligera (cursiva solo en el «&», la fecha y los pies de foto),
       Jost espaciada para las etiquetas, verde eucalipto (principal) y rosa
       empolvado (secundario). Ornamento propio: una rama de eucalipto dibujada
       a línea que abre las secciones. */
    :root {
      --bg: #fbf8f5;
      --surface: #f6ede9;
      --surface-2: #eee0da;
      --text: #2c2c28;
      --muted: #67655f;
      --border: #e7dcd6;
      --radius-sm: 4px;
      --radius: 6px;
      --radius-lg: 10px;
      --radius-btn: 999px;
      --header-h: 5rem;
      --blush: color-mix(in srgb, var(--secondary) 38%, var(--bg));
      --green-dark: color-mix(in srgb, var(--primary) 32%, #0e110e);
      --on-dark: #f6f1ec;
      --on-dark-muted: rgb(246 241 236 / 0.72);
      --line: color-mix(in srgb, var(--primary-ink) 45%, transparent);
    }
    html.bi-dark {
      --bg: #131412;
      --surface: #1b1c19;
      --surface-2: #252621;
      --text: #f1ece6;
      --muted: #b1aba3;
      --border: #33342f;
      --blush: color-mix(in srgb, var(--secondary) 8%, var(--surface));
      --green-dark: color-mix(in srgb, var(--primary) 20%, #0a0c0a);
    }

    h1, h2, h3 { font-weight: 400; letter-spacing: 0; }
    .title { font-size: clamp(2.5rem, 1.6rem + 3.2vw, 4.25rem); font-weight: 300; line-height: 1.05; }
    .lead { font-weight: 300; }
    .btn { font-weight: 500; letter-spacing: 0.06em; }
    .btn-outline { border-color: color-mix(in srgb, var(--text) 30%, transparent); }

    /* Etiqueta de invitación: versalitas espaciadas */
    .label {
      display: block;
      margin-bottom: 1.25rem;
      color: var(--primary-ink);
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.26em;
      line-height: 1.5;
      text-transform: uppercase;
    }

    /* Rama de eucalipto */
    .ornament { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--primary-ink); }
    .ornament svg { width: clamp(4.5rem, 3.5rem + 2vw, 6rem); height: auto; }
    .ornament svg:first-child { transform: scaleX(-1); }
    .ornament::before { content: ""; order: 1; width: 0.3rem; height: 0.3rem; border-radius: 50%; background: currentColor; }
    .ornament svg:last-child { order: 2; }

    .head { max-width: 46rem; margin: 0 auto clamp(3rem, 6vw, 4.5rem); text-align: center; }
    .head .ornament { margin-bottom: 1.25rem; }
    .head .lead { max-width: 36rem; margin-inline: auto; }

    /* Rejilla de fotos: la última fila incompleta queda centrada */
    .flow { --cols: 1; --gap: clamp(1rem, 2.5vw, 2rem); display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: clamp(2rem, 4vw, 3rem) var(--gap); }
    .flow > * { flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols) - 0.05px); min-width: 0; }
    .flow.c1 > * { flex-basis: min(100%, 26rem); }
    .flow.c2 { --cols: 2; }
    .flow.c3 { --cols: 3; }
    .flow.c4 { --cols: 4; }
    @media (max-width: 900px) { .flow.c4 { --cols: 2; } }
    @media (max-width: 640px) { .flow.c3 { --cols: 2; } }

    /* ---------- Cabecera (sobre la foto de portada) ---------- */
    .site-header { position: absolute; inset: 0 0 auto; background: transparent; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none; color: #fff; }
    .site-header.solid { position: sticky; background: color-mix(in srgb, var(--bg) 90%, transparent); border-bottom: 1px solid var(--border); color: var(--text); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
    .site-header .brand { font-size: 1.75rem; font-weight: 400; font-style: italic; letter-spacing: 0.02em; }
    .nav-links { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; }
    .site-header .nav-links a { color: inherit; opacity: 0.85; }
    .site-header .nav-links a:hover { opacity: 1; }
    .site-header:not(.solid) .nav-cta { background: #fff; color: #23231f; }
    .site-header:not(.solid) .nav-cta:hover { background: rgb(255 255 255 / 0.88); }
    .nav-cta { font-size: 0.8125rem; letter-spacing: 0.12em; text-transform: uppercase; }
    .menu-panel { color: var(--text); }

    /* ---------- Portada ---------- */
    .hero {
      position: relative;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
      min-height: min(100svh, 980px);
      padding: calc(var(--header-h) + 3rem) 0 clamp(3.5rem, 8vh, 6.5rem);
      overflow: hidden;
      background:
        radial-gradient(60% 70% at 50% 25%, color-mix(in srgb, var(--secondary) 26%, transparent), transparent 70%),
        var(--green-dark);
      color: #fff;
      text-align: center;
    }
    .hero:not(.has-media) { min-height: min(80svh, 760px); }
    .hero-media { position: absolute; inset: 0; z-index: -2; }
    .hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
    .hero.has-media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(to top, rgb(12 14 11 / 0.82) 0%, rgb(12 14 11 / 0.45) 42%, rgb(12 14 11 / 0.12) 70%, rgb(12 14 11 / 0.3) 100%);
    }
    .hero-inner { display: flex; flex-direction: column; align-items: center; }
    .hero .ornament { color: color-mix(in srgb, var(--secondary) 75%, #fff); margin-bottom: 1.25rem; }
    .hero-date { color: rgb(255 255 255 / 0.9); font-size: clamp(0.8125rem, 0.75rem + 0.25vw, 0.9375rem); font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; }
    .hero-title {
      max-width: 14ch;
      margin-top: 1rem;
      font-size: clamp(4rem, 1.9rem + 8vw, 10rem);
      font-weight: 300;
      line-height: 0.92;
      letter-spacing: -0.01em;
    }
    .hero-title.t-m { max-width: 18ch; font-size: clamp(2.75rem, 1.5rem + 5vw, 6.5rem); line-height: 0.98; }
    .hero-title.t-l { max-width: 24ch; font-size: clamp(2.25rem, 1.4rem + 3vw, 4.25rem); line-height: 1.05; }
    .amp { font-style: italic; font-weight: 300; color: color-mix(in srgb, var(--secondary) 70%, #fff); padding-inline: 0.04em; }
    .hero-sub { max-width: 36rem; margin-top: 1.5rem; color: rgb(255 255 255 / 0.9); font-family: var(--font-heading); font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); font-style: italic; line-height: 1.4; }
    .hero .actions { justify-content: center; margin-top: 2.25rem; }
    .hero .btn-light { color: #23231f; }

    /* ---------- Nuestra historia ---------- */
    .about-grid { display: grid; gap: clamp(3.5rem, 7vw, 6.5rem); align-items: center; }
    .about-media { justify-self: center; width: min(100%, 26rem); padding: 1rem; }
    .arch {
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: 50% 50% 0 0 / 37.5% 37.5% 0 0;
      background: var(--surface-2);
      box-shadow: 0 0 0 0.875rem var(--bg), 0 0 0 calc(0.875rem + 1px) var(--line);
    }
    .arch > * { width: 100%; height: 100%; object-fit: cover; }
    .about-title { font-size: clamp(2.25rem, 1.5rem + 2.8vw, 3.75rem); font-weight: 300; line-height: 1.08; }
    .about-copy .lead { margin-top: 1rem; }
    .about-copy .prose { margin-top: 1.75rem; max-width: 34rem; color: var(--muted); font-size: 1.0625rem; font-weight: 300; line-height: 1.8; }
    .about-copy .prose p:first-child::first-letter {
      float: left;
      margin: 0.06em 0.12em 0 0;
      color: var(--primary-ink);
      font-family: var(--font-heading);
      font-size: 4.1em;
      font-weight: 300;
      line-height: 0.8;
    }
    @media (min-width: 900px) { .about-grid.two { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } }

    /* ---------- Programa ---------- */
    .program { background: var(--blush); }
    .timeline { position: relative; max-width: 52rem; margin-inline: auto; }
    .moment { position: relative; display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: 0 1.25rem; padding-bottom: 2.5rem; }
    .moment:last-child { padding-bottom: 0; }
    .moment::before { content: ""; position: absolute; left: calc(0.75rem - 0.5px); top: 1.5rem; bottom: -0.25rem; width: 1px; background: var(--line); }
    .moment:last-child::before { display: none; }
    .moment-dot { grid-row: 1 / span 2; width: 1.5rem; height: 1.5rem; margin-top: 0.4rem; border: 1px solid var(--line); border-radius: 50%; background: var(--blush); position: relative; }
    .moment-dot::after { content: ""; position: absolute; inset: 0.4rem; border-radius: 50%; background: var(--primary); }
    .moment-time { color: var(--primary-ink); font-family: var(--font-heading); font-size: clamp(1.75rem, 1.5rem + 1vw, 2.5rem); font-weight: 400; font-style: italic; line-height: 1.1; font-variant-numeric: lining-nums; }
    .moment-body h3 { font-size: clamp(1.625rem, 1.4rem + 0.8vw, 2rem); font-weight: 400; line-height: 1.2; }
    .moment-body p { margin-top: 0.375rem; color: var(--muted); font-weight: 300; max-width: 30rem; }
    @media (min-width: 760px) {
      .moment { grid-template-columns: minmax(0, 1fr) 1.5rem minmax(0, 1fr); gap: 0 2.5rem; padding-bottom: 3rem; }
      .moment::before { left: calc(50% - 0.5px); }
      .moment-time { grid-column: 1; grid-row: 1; text-align: right; padding-top: 0.05rem; }
      .moment-dot { grid-column: 2; grid-row: 1; }
      .moment-body { grid-column: 3; grid-row: 1; }
    }

    /* ---------- Fotos ---------- */
    .photo { margin: 0; }
    .photo-frame { aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius-sm); background: var(--surface-2); }
    .photo-frame > * { width: 100%; height: 100%; object-fit: cover; }
    .photo figcaption { margin-top: 0.875rem; color: var(--muted); font-family: var(--font-heading); font-size: 1.1875rem; font-style: italic; line-height: 1.35; text-align: center; }
    /* Composición escalonada, como fotos sueltas sobre la mesa */
    @media (min-width: 641px) {
      .flow.c3 > :nth-child(3n + 2) { margin-top: clamp(2rem, 5vw, 4.5rem); }
    }
    @media (min-width: 901px) {
      .flow.c4 > :nth-child(even) { margin-top: clamp(2rem, 4vw, 3.5rem); }
    }
    @media (max-width: 900px) {
      .flow.c4 > :nth-child(even) { margin-top: 2.5rem; }
    }
    .flow.c2 > :nth-child(even) { margin-top: clamp(2rem, 5vw, 3.5rem); }
    @media (max-width: 640px) {
      .flow.c3 > :nth-child(even) { margin-top: 2.5rem; }
    }

    /* ---------- Dudas ---------- */
    .faqs { background: var(--surface); }
    html.bi-dark .faqs { background: var(--surface); }
    .faq-grid { display: grid; gap: 2.5rem; }
    .faq-grid .head { margin: 0; text-align: left; }
    .faq-grid .head .lead { margin-inline: 0; }
    .faq-list { border-top: 1px solid var(--line); }
    .faq-item { border-bottom: 1px solid var(--line); }
    .faq-item > summary { padding: 1.5rem 0; font-family: var(--font-heading); font-size: clamp(1.375rem, 1.25rem + 0.5vw, 1.6875rem); font-weight: 400; line-height: 1.3; }
    .faq-item > summary .faq-icon { width: 1.25rem; height: 1.25rem; color: var(--primary-ink); }
    .faq-answer { padding: 0 2.5rem 1.75rem 0; color: var(--muted); font-weight: 300; }
    .faq-answer p + p { margin-top: 0.75rem; }
    @media (min-width: 900px) {
      .faq-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 5rem; }
      .faq-grid .head { position: sticky; top: 3rem; align-self: start; }
    }

    /* ---------- Confirmación (tarjeta de invitación) ---------- */
    .rsvp { background: var(--blush); }
    .card {
      max-width: 46rem;
      margin-inline: auto;
      padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 6vw, 4.5rem);
      background: var(--bg);
      border: 1px solid var(--line);
      outline: 1px solid var(--line);
      outline-offset: -0.75rem;
      text-align: center;
    }
    .card .ornament { margin-bottom: 1.5rem; }
    .cta-title { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem); font-weight: 300; line-height: 1.02; }
    .cta-title.t-l { font-size: clamp(2rem, 1.4rem + 2.2vw, 3.25rem); }
    .card p { max-width: 32rem; margin: 1.25rem auto 0; color: var(--muted); font-weight: 300; font-size: 1.0625rem; }
    .card .actions { justify-content: center; margin-top: 2.25rem; }

    /* ---------- Lugar ---------- */
    .venue-grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
    .venue-main .lead { max-width: 32rem; }
    .venue-address { display: flex; gap: 0.875rem; margin-top: 2rem; max-width: 30rem; font-size: 1.0625rem; }
    .venue-address .icon { width: 1.25rem; height: 1.25rem; margin-top: 0.2rem; color: var(--primary-ink); }
    .venue-main .actions { margin-top: 1.75rem; }
    .venue-side { padding-top: 0.25rem; }
    .venue-side h3 { margin-bottom: 0.5rem; font-size: 1.75rem; font-weight: 400; font-style: italic; }
    .venue-lines li { border-bottom: 1px solid var(--border); }
    .venue-lines a, .venue-lines span.row { display: flex; align-items: center; gap: 0.875rem; min-height: 3.25rem; padding: 0.75rem 0; overflow-wrap: anywhere; }
    .venue-lines a:hover { color: var(--primary-ink); }
    .venue-lines .icon { width: 1.125rem; height: 1.125rem; color: var(--primary-ink); }
    .venue-hours { margin-top: 2rem; }
    .venue-hours li { padding: 0.5rem 0; border-bottom: 1px dashed var(--border); color: var(--muted); }
    @media (min-width: 900px) { .venue-grid.two { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); } }

    /* ---------- Pie ---------- */
    .site-footer { padding: clamp(4rem, 8vw, 6rem) 0 2rem; box-shadow: inset 0 1px 0 rgb(246 241 236 / 0.1); background: var(--green-dark); color: var(--on-dark-muted); text-align: center; }
    .site-footer .ornament { color: color-mix(in srgb, var(--secondary) 75%, #fff); }
    .footer-brand { margin-top: 1rem; color: var(--on-dark); font-family: var(--font-heading); font-size: clamp(3rem, 2rem + 4vw, 5.5rem); font-style: italic; font-weight: 300; line-height: 1; overflow-wrap: anywhere; }
    .footer-brand img { height: 3.5rem; width: auto; margin-inline: auto; }
    .footer-text { max-width: 30rem; margin: 1rem auto 0; font-family: var(--font-heading); font-size: 1.25rem; font-style: italic; }
    .footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem 2rem; margin-top: 2rem; font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; }
    .footer-links a { color: var(--on-dark); overflow-wrap: anywhere; }
    .footer-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .footer-bottom { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 2rem; margin-top: clamp(3rem, 6vw, 4rem); padding-top: 1.75rem; border-top: 1px solid rgb(246 241 236 / 0.14); font-size: 0.875rem; }
  </style>
</head>
<body>
  <a class="skip-link" href="#main"><%= t("skip") %></a>

  <%
    // Rama de eucalipto a línea (decorativa)
    const SPRIG = '<svg viewBox="0 0 120 32" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 23c28-4 62-9 112-15"/><ellipse fill="currentColor" fill-opacity=".16" cx="20" cy="15.5" rx="5.5" ry="3.8" transform="rotate(-25 20 15.5)"/><ellipse fill="currentColor" fill-opacity=".16" cx="30" cy="26" rx="5.5" ry="3.8" transform="rotate(20 30 26)"/><ellipse fill="currentColor" fill-opacity=".16" cx="44" cy="12" rx="6" ry="4.2" transform="rotate(-25 44 12)"/><ellipse fill="currentColor" fill-opacity=".16" cx="56" cy="22" rx="6" ry="4.2" transform="rotate(20 56 22)"/><ellipse fill="currentColor" fill-opacity=".16" cx="70" cy="8.5" rx="6" ry="4.2" transform="rotate(-25 70 8.5)"/><ellipse fill="currentColor" fill-opacity=".16" cx="82" cy="18" rx="5.5" ry="3.8" transform="rotate(20 82 18)"/><ellipse fill="currentColor" fill-opacity=".16" cx="96" cy="6" rx="5" ry="3.4" transform="rotate(-25 96 6)"/><ellipse fill="currentColor" fill-opacity=".16" cx="108" cy="14" rx="4.5" ry="3" transform="rotate(20 108 14)"/></svg>';
    const ornament = () => `<span class="ornament" aria-hidden="true">${SPRIG}${SPRIG}</span>`;

    function sectionHead(key, extraClass) {
      const h = heading(key);
      if (!h.eyebrow && !h.title && !h.subtitle) return;
  %>
    <div class="head <%= extraClass || '' %>">
      <%- ornament() %>
      <% if (h.eyebrow) { %><p class="label"><%= h.eyebrow %></p><% } %>
      <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
      <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
    </div>
  <% } %>

  <%
    function colsFor(n, max) {
      if (n <= max) return n;
      if (n % max === 0) return max;
      if (n % (max - 1) === 0) return max - 1;
      return n % max >= n % (max - 1) ? max : max - 1;
    }
    const c = config.contact;
    const hourLines = lines(c.hours);
    const titleSize = (text, m, l) => (text.length > l ? "t-l" : text.length > m ? "t-m" : "");
  %>

  <header class="site-header<%= show('hero') ? '' : ' solid' %>" data-section="brand">
    <div class="container nav">
      <a class="brand" href="#main">
        <% if (config.brand.logo) { %><%- img(config.brand.logo, config.brand.name, { eager: true, sizes: "160px", width: 480 }) %><% } %>
        <% if (config.brand.name || !config.brand.logo) { %><span><%= config.brand.name %></span><% } %>
      </a>
      <%- navLinks({ limit: 5 }) %>
      <% if (config.hero.ctaText && show("hero")) { %>
        <a class="btn btn-primary btn-sm nav-cta" <%- linkAttrs(config.hero.ctaLink) %>><%= config.hero.ctaText %></a>
      <% } %>
      <%- mobileMenu({ cta: show("hero") ? { text: config.hero.ctaText, href: config.hero.ctaLink } : undefined }) %>
    </div>
  </header>

  <main id="main">
    <% if (show("hero")) { const hero = config.hero; const parts = hero.title.split("&"); %>
    <section class="hero<%= hero.backgroundImage ? ' has-media' : '' %>" id="hero" data-section="hero">
      <% if (hero.backgroundImage) { %>
        <div class="hero-media"><%- img(hero.backgroundImage, "", { eager: true, width: 2000 }) %></div>
      <% } %>
      <div class="container hero-inner">
        <span class="rise"><%- ornament() %></span>
        <% if (hero.eyebrow) { %><p class="hero-date rise"><%= hero.eyebrow %></p><% } %>
        <% if (hero.title) { %>
          <h1 class="hero-title rise-2 <%= titleSize(hero.title, 24, 60) %>"><% parts.forEach((part, i) => { %><%= part %><% if (i < parts.length - 1) { %><span class="amp">&amp;</span><% } %><% }) %></h1>
        <% } %>
        <% if (hero.subtitle) { %><p class="hero-sub rise-3"><%= hero.subtitle %></p><% } %>
        <% if (hero.ctaText || hero.secondaryCtaText) { %>
        <div class="actions rise-3">
          <% if (hero.ctaText) { %><a class="btn btn-light btn-lg" <%- linkAttrs(hero.ctaLink) %>><%= hero.ctaText %></a><% } %>
          <% if (hero.secondaryCtaText) { %><a class="btn btn-ghost-light btn-lg" <%- linkAttrs(hero.secondaryCtaLink) %>><%= hero.secondaryCtaText %></a><% } %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (show("about")) { const a = config.about; const h = heading("about"); %>
    <section class="section" id="about" data-section="about">
      <div class="container about-grid<%= a.image ? ' two' : '' %>">
        <% if (a.image) { %>
        <div class="about-media"><div class="arch"><%- img(a.image, a.heading, { sizes: "(min-width: 900px) 26rem, 90vw", width: 1200 }) %></div></div>
        <% } %>
        <div class="about-copy">
          <% if (h.eyebrow) { %><p class="label"><%= h.eyebrow %></p><% } %>
          <% if (a.heading) { %><h2 class="about-title"><%= a.heading %></h2><% } %>
          <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
          <% if (a.content) { %><div class="prose"><%- paras(a.content) %></div><% } %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("steps")) { %>
    <section class="section program" id="steps" data-section="steps">
      <div class="container">
        <% sectionHead("steps") %>
        <ol class="timeline">
          <% config.steps.forEach((s, i) => { %>
            <li class="moment">
              <span class="moment-time"><% if (s.label) { %><%= s.label %><% } else { %><span class="sr-only"><%= t("moment") %> </span><%= i + 1 %><% } %></span>
              <span class="moment-dot" aria-hidden="true"></span>
              <div class="moment-body">
                <% if (s.title) { %><h3><%= s.title %></h3><% } %>
                <% if (s.description) { %><p><%= s.description %></p><% } %>
              </div>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>
    <% } %>

    <% if (show("gallery")) { %>
    <section class="section" id="gallery" data-section="gallery">
      <div class="container">
        <% sectionHead("gallery") %>
        <div class="flow c<%= colsFor(config.gallery.length, 4) %>">
          <% config.gallery.forEach((g) => { %>
            <figure class="photo">
              <div class="photo-frame"><%- img(g.image, g.caption, { sizes: "(min-width: 900px) 360px, 50vw", width: 1200, placeholder: "heart" }) %></div>
              <% if (g.caption) { %><figcaption><%= g.caption %></figcaption><% } %>
            </figure>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("faqs")) { %>
    <section class="section faqs" id="faqs" data-section="faqs">
      <div class="container faq-grid">
        <div><% sectionHead("faqs") %></div>
        <div class="faq-list">
          <% config.faqs.forEach((f, i) => { %>
            <details class="faq-item"<%= i === 0 ? " open" : "" %>>
              <summary><span><%= f.question || t("question") %></span><%- icon("plus", "faq-icon") %></summary>
              <% if (f.answer) { %><div class="faq-answer"><%- paras(f.answer) %></div><% } %>
            </details>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("cta")) { const cta = config.cta; %>
    <section class="section rsvp" id="cta" data-section="cta">
      <div class="container">
        <div class="card">
          <%- ornament() %>
          <% if (cta.title) { %><h2 class="cta-title <%= cta.title.length > 40 ? 't-l' : '' %>"><%= cta.title %></h2><% } %>
          <% if (cta.text) { %><p><%= cta.text %></p><% } %>
          <% if (cta.buttonText) { %>
            <div class="actions"><a class="btn btn-primary btn-lg" <%- linkAttrs(cta.buttonLink) %>><%= cta.buttonText %></a></div>
          <% } %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("contact")) {
         const h = heading("contact");
         const hasLines = c.phone || c.email || c.whatsapp;
         const hasMain = h.eyebrow || h.title || h.subtitle || c.address;
         const hasSide = hasLines || hourLines.length;
    %>
    <section class="section" id="contact" data-section="contact">
      <div class="container venue-grid<%= hasMain && hasSide ? ' two' : '' %>">
        <% if (hasMain) { %>
        <div class="venue-main">
          <% if (h.eyebrow) { %><p class="label"><%= h.eyebrow %></p><% } %>
          <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
          <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
          <% if (c.address) { %>
            <p class="venue-address"><%- icon("map-pin") %><span><span class="sr-only"><%= t("venue") %>: </span><%= c.address %></span></p>
            <div class="actions"><a class="btn btn-outline" <%- linkAttrs(mapsHref(c.address)) %>><%= t("directions") %><%- icon("arrow-up-right", "") %></a></div>
          <% } %>
        </div>
        <% } %>
        <% if (hasSide) { %>
        <div class="venue-side">
          <% if (hasLines) { %>
          <h3><%= t("questions") %></h3>
          <ul class="venue-lines">
            <% if (c.phone) { %><li><a href="<%= telHref(c.phone) %>"><%- icon("phone") %><%= c.phone %></a></li><% } %>
            <% if (c.whatsapp) { %><li><a <%- linkAttrs(waHref(c.whatsapp)) %>><%- icon("message-circle") %><%= t("whatsapp") %></a></li><% } %>
            <% if (c.email) { %><li><a href="<%= mailHref(c.email) %>"><%- icon("mail") %><%= c.email %></a></li><% } %>
          </ul>
          <% } %>
          <% if (hourLines.length) { %>
          <div class="venue-hours">
            <h3><%= t("hours") %></h3>
            <ul><% hourLines.forEach((line) => { %><li><%= line %></li><% }) %></ul>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>
  </main>

  <% if (show("footer")) { %>
  <footer class="site-footer" id="footer" data-section="footer">
    <div class="container">
      <%- ornament() %>
      <p class="footer-brand"><% if (config.brand.logo && !config.brand.name) { %><%- img(config.brand.logo, "", { sizes: "160px", width: 480 }) %><% } else { %><%= config.brand.name %><% } %></p>
      <% if (config.footer.text) { %><p class="footer-text"><%= config.footer.text %></p><% } %>
      <% if (config.footer.links.length) { %>
      <nav class="footer-links" aria-label="<%= config.brand.name %>">
        <% config.footer.links.forEach((l) => { %><a <%- linkAttrs(l.url) %>><%= l.label || l.url %></a><% }) %>
      </nav>
      <% } %>
      <div class="footer-bottom">
        <p><%- copyright(config.brand.name) %></p>
        <%- madeWith %>
      </div>
    </div>
  </footer>
  <% } %>

  <%- foot %>
</body>
</html>
