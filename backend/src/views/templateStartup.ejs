<!DOCTYPE html>
<html <%- htmlAttrs %>>
<head>
  <%- head %>
  <style>
    /* Startup: web de producto nítida. Blanco y casi negro con azul eléctrico,
       titulares grotescos muy apretados, portada centrada con la app enmarcada en
       una ventana de navegador (o una interfaz dibujada en CSS si no hay captura),
       funciones en rejilla bento y bandas oscuras para la demo y la llamada final. */
    :root {
      --bg: #ffffff;
      --surface: #f6f7f9;
      --surface-2: #eceef2;
      --text: #0a0a0b;
      --muted: #5b6170;
      --border: #e5e7ec;
      --radius-sm: 8px;
      --radius: 14px;
      --radius-lg: 20px;
      --radius-btn: 10px;
      --header-h: 4rem;
      --section-y: clamp(4.5rem, 9vw, 7.5rem);
      /* Bandas oscuras: siempre oscuras, tiñidas por el color secundario */
      --ink: color-mix(in srgb, var(--secondary) 20%, #07080a);
      --ink-line: rgb(255 255 255 / 0.1);
      --grid-line: color-mix(in srgb, var(--text) 6%, transparent);
      --lift: 0 40px 80px -40px rgb(12 22 48 / 0.32);
    }
    html.bi-dark {
      --bg: #09090b;
      --surface: #101114;
      --surface-2: #17191d;
      --text: #f2f3f5;
      --muted: #9ba0ab;
      --border: #24262c;
      --ink: color-mix(in srgb, var(--secondary) 16%, #131419);
      --ink-line: rgb(255 255 255 / 0.09);
      --grid-line: rgb(255 255 255 / 0.05);
      --lift: 0 40px 80px -40px rgb(0 0 0 / 0.8);
    }

    h1, h2, h3, .title { font-weight: 600; letter-spacing: -0.035em; }
    .title { font-size: clamp(2rem, 1.35rem + 2.5vw, 3.25rem); line-height: 1.05; }
    .lead { font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem); }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: 0;
      text-transform: none;
      font-size: 0.9375rem;
      font-weight: 500;
    }
    .eyebrow::before {
      content: "";
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 2px;
      background: var(--primary);
    }
    .btn { font-weight: 550; letter-spacing: -0.005em; }
    .btn-primary { box-shadow: 0 1px 0 rgb(255 255 255 / 0.2) inset, 0 8px 20px -10px color-mix(in srgb, var(--primary) 80%, transparent); }
    .btn-outline { background: var(--bg); border-color: var(--border); box-shadow: var(--shadow-sm); }
    .btn-outline:hover { border-color: color-mix(in srgb, var(--text) 35%, transparent); }

    /* Cabecera de sección partida: título a la izquierda, entradilla a la derecha */
    .head-split { max-width: none; display: grid; gap: 1rem 4rem; }
    .head-split .lead { margin-top: 0; max-width: 34rem; }
    @media (min-width: 900px) {
      .head-split { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: end; }
    }

    /* Cabecera */
    .site-header .brand { font-size: 1.1875rem; font-weight: 650; letter-spacing: -0.03em; }
    .brand-mark {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 1.875rem;
      height: 1.875rem;
      border-radius: 9px;
      background: var(--primary);
      color: var(--on-primary);
      font-size: 0.9375rem;
      font-weight: 700;
      letter-spacing: 0;
      box-shadow: 0 1px 0 rgb(255 255 255 / 0.25) inset;
    }
    .nav-links a { color: var(--muted); }
    .nav-cta { margin-left: auto; }
    @media (min-width: 901px) {
      .nav .brand { margin-right: 0; }
      .nav .nav-links { margin-inline: auto; }
    }
    .menu { margin-left: auto; }

    /* Portada */
    .hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3.5rem, 7vw, 6rem);
      text-align: center;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: -2;
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 4rem 4rem;
      background-position: center top;
      -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, #000 30%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, #000 30%, transparent 78%);
    }
    .hero::after {
      content: "";
      position: absolute;
      z-index: -1;
      left: 50%;
      bottom: 4%;
      width: min(72rem, 130%);
      height: 60%;
      transform: translateX(-50%);
      background: radial-gradient(closest-side, color-mix(in srgb, var(--primary) 20%, transparent), transparent);
    }
    .hero-inner { display: flex; flex-direction: column; align-items: center; }
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      max-width: 100%;
      padding: 0.3125rem 1rem 0.3125rem 0.3125rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      box-shadow: var(--shadow-sm);
      color: var(--text);
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.35;
      text-align: left;
    }
    .pill-tag {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 1.625rem;
      height: 1.625rem;
      border-radius: 999px;
      background: var(--primary);
      color: var(--on-primary);
    }
    .pill-tag svg { width: 0.875rem; height: 0.875rem; }
    .hero-title {
      max-width: 16ch;
      margin-top: 1.75rem;
      font-size: clamp(2.625rem, 1.15rem + 5.6vw, 5.5rem);
      line-height: 1.01;
      letter-spacing: -0.048em;
    }
    .hero-title:first-child { margin-top: 0; }
    .hero-title.is-long {
      max-width: 24ch;
      font-size: clamp(2.125rem, 1.4rem + 2.6vw, 3.75rem);
      line-height: 1.06;
      letter-spacing: -0.04em;
    }
    .hero-sub {
      max-width: 40rem;
      margin-top: 1.5rem;
      color: var(--muted);
      font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
      line-height: 1.6;
    }
    .hero-actions { justify-content: center; margin-top: 2.25rem; }
    @media (max-width: 480px) {
      .hero-actions { flex-direction: column; align-items: stretch; width: 100%; max-width: 22rem; }
    }

    /* Ventana del producto */
    .product {
      position: relative;
      width: 100%;
      max-width: 68rem;
      margin-top: clamp(3rem, 7vw, 4.75rem);
      text-align: left;
    }
    .window {
      padding: 0.4375rem;
      border: 1px solid var(--border);
      border-radius: 1.25rem;
      background: color-mix(in srgb, var(--surface) 75%, transparent);
      box-shadow: var(--lift), 0 0 0 6px color-mix(in srgb, var(--bg) 50%, transparent);
    }
    .window-bar {
      display: grid;
      grid-template-columns: 1fr minmax(0, auto) 1fr;
      align-items: center;
      gap: 0.75rem;
      height: 2.375rem;
      padding: 0 0.625rem 0.4375rem;
    }
    .dots { display: flex; gap: 0.375rem; }
    .dots i { width: 0.6875rem; height: 0.6875rem; border-radius: 50%; background: var(--surface-2); box-shadow: 0 0 0 1px var(--border) inset; }
    .url {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      min-width: 0;
      max-width: 22rem;
      padding: 0.25rem 1rem;
      border-radius: 7px;
      background: var(--bg);
      box-shadow: 0 0 0 1px var(--border) inset;
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 500;
      white-space: nowrap;
    }
    .url span { overflow: hidden; text-overflow: ellipsis; }
    .url svg { width: 0.75rem; height: 0.75rem; flex-shrink: 0; }
    .window-body {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: 0.8125rem;
      background: var(--bg);
      box-shadow: 0 0 0 1px var(--border);
      container-type: inline-size;
    }
    .window-body > img,
    .window-body > .ph { width: 100%; height: 100%; object-fit: cover; object-position: top center; }

    /* Interfaz dibujada en CSS cuando no hay captura: un planificador semanal */
    .mock {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: 17% minmax(0, 1fr);
      font-size: clamp(3.5px, 1.05cqw, 12px);
      background: var(--bg);
    }
    .mock i, .mock b { display: block; font-style: normal; }
    .mock-side {
      display: flex;
      flex-direction: column;
      gap: 1.15em;
      padding: 1.75em 1.5em;
      border-right: 1px solid var(--border);
      background: var(--surface);
    }
    .m-logo { width: 2.5em; height: 2.5em; margin-bottom: 1.2em; border-radius: 0.75em; background: var(--primary); }
    .m-nav { width: 78%; height: 1.05em; border-radius: 999px; background: var(--surface-2); }
    .m-nav:nth-child(3) { width: 62%; }
    .m-nav:nth-child(4) { width: 86%; }
    .m-nav:nth-child(5) { width: 54%; }
    .m-nav.is-on { width: 92%; background: color-mix(in srgb, var(--primary) 32%, var(--surface-2)); }
    .m-user { margin-top: auto; height: 3em; border-radius: 0.9em; background: var(--surface-2); }
    .mock-main { display: flex; flex-direction: column; gap: 1.6em; min-width: 0; padding: 1.75em 2.25em 2.25em; }
    .mock-top { display: flex; align-items: center; gap: 1em; }
    .m-title { width: 24%; height: 1.7em; border-radius: 0.45em; background: var(--text); opacity: 0.86; }
    .m-sub { width: 12%; height: 1.1em; border-radius: 999px; background: var(--surface-2); }
    .m-seg { width: 17%; height: 2.6em; margin-left: auto; border-radius: 0.75em; background: var(--surface); box-shadow: 0 0 0 1px var(--border) inset; }
    .m-btn { width: 11%; height: 2.6em; border-radius: 0.75em; background: var(--primary); }
    .mock-cal {
      flex: 1;
      display: grid;
      grid-template-rows: 3.2em repeat(7, minmax(0, 1fr));
      overflow: hidden;
      border-radius: 1em;
      box-shadow: 0 0 0 1px var(--border) inset;
      /* fin de semana sombreado */
      background: linear-gradient(90deg, transparent 76.3%, color-mix(in srgb, var(--surface) 70%, transparent) 76.3%);
    }
    .m-head, .m-row { display: grid; grid-template-columns: 17% repeat(7, minmax(0, 1fr)); align-items: center; }
    .m-head { border-bottom: 1px solid var(--border); background: var(--surface); }
    .m-head i { grid-row: 1; width: 46%; height: 0.95em; margin: 0 auto; border-radius: 999px; background: var(--surface-2); }
    .m-head i.is-today { background: var(--primary); }
    .m-row { position: relative; border-bottom: 1px solid var(--border); }
    .m-row:last-child { border-bottom: 0; }
    .m-person { grid-column: 1; grid-row: 1; display: flex; align-items: center; gap: 0.75em; padding-left: 1.1em; min-width: 0; }
    .m-av { flex-shrink: 0; width: 2.2em; height: 2.2em; border-radius: 50%; background: color-mix(in srgb, var(--primary) 30%, var(--surface-2)); }
    .m-row:nth-child(3n) .m-av { background: color-mix(in srgb, var(--secondary) 35%, var(--surface-2)); }
    .m-row:nth-child(3n + 1) .m-av { background: color-mix(in srgb, var(--primary) 55%, var(--surface-2)); }
    .m-name { width: 5.5em; height: 0.95em; border-radius: 999px; background: var(--surface-2); }
    .m-row b {
      grid-row: 1;
      height: 64%;
      margin: 0 0.3em;
      border-radius: 0.6em;
      background: color-mix(in srgb, var(--primary) 13%, var(--bg));
      box-shadow: inset 0.3em 0 0 var(--primary);
    }
    .m-row b::before, .m-row b::after {
      content: "";
      display: block;
      height: 0.8em;
      margin: 0.85em 0 0 1.1em;
      border-radius: 999px;
      background: color-mix(in srgb, var(--primary) 45%, transparent);
    }
    .m-row b::before { width: min(60%, 9em); }
    .m-row b::after { width: min(35%, 5em); margin-top: 0.55em; opacity: 0.55; }
    .m-row b.alt::before, .m-row b.alt::after { background: color-mix(in srgb, var(--text) 20%, transparent); }
    .m-row b.hi::before, .m-row b.hi::after { background: color-mix(in srgb, var(--on-primary) 75%, transparent); }
    .m-row b.alt { background: var(--surface-2); box-shadow: inset 0.3em 0 0 color-mix(in srgb, var(--text) 25%, transparent); }
    .m-row b.hi { background: var(--primary); box-shadow: 0 0.6em 1.4em -0.6em color-mix(in srgb, var(--primary) 80%, transparent); }
    .mock-toast {
      position: absolute;
      right: 3.5%;
      bottom: 7%;
      display: flex;
      align-items: center;
      gap: 1.1em;
      padding: 1.2em 1.6em 1.2em 1.2em;
      border-radius: 1.2em;
      background: var(--bg);
      box-shadow: 0 0 0 1px var(--border), 0 1.8em 3.5em -1.4em rgb(12 22 48 / 0.45);
    }
    .m-check { display: grid; place-items: center; width: 2.8em; height: 2.8em; border-radius: 50%; background: var(--primary); color: var(--on-primary); }
    .m-check svg { width: 1.5em; height: 1.5em; stroke-width: 2.5; }
    .m-lines { display: grid; gap: 0.6em; }
    .m-lines i:first-child { width: 12em; height: 1em; border-radius: 999px; background: var(--text); opacity: 0.8; }
    .m-lines i:last-child { width: 8em; height: 0.9em; border-radius: 999px; background: var(--surface-2); }
    @container (max-width: 560px) {
      .mock { grid-template-columns: minmax(0, 1fr); font-size: 1.6cqw; }
      .mock-side, .m-name, .m-sub, .m-seg, .mock-toast { display: none; }
      .mock-main { padding: 1.5em; gap: 1.2em; }
      .m-title { width: 34%; }
      .m-btn { width: 18%; margin-left: auto; }
      .m-head, .m-row { grid-template-columns: 12% repeat(7, minmax(0, 1fr)); }
      .m-person { padding-left: 0.6em; }
    }

    /* Cifras */
    .stats { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
    .stats .section-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
    .stats .title { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem); letter-spacing: -0.03em; }
    .stat-grid { overflow: hidden; }
    .stats + .section { padding-top: clamp(2.5rem, 5vw, 4rem); }
    .stat-grid dl {
      display: grid;
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      margin: -1px 0 0 -1px;
    }
    .stat {
      display: flex;
      flex-direction: column-reverse;
      justify-content: flex-end;
      gap: 0.5rem;
      padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2.5vw, 2rem);
      border-left: 1px solid var(--border);
      border-top: 1px solid var(--border);
      text-align: center;
    }
    .stat dd {
      font-family: var(--font-heading);
      font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem);
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.045em;
      font-variant-numeric: tabular-nums;
    }
    .stat dt { color: var(--muted); font-size: 0.9375rem; line-height: 1.45; }
    .cols-1 { --cols: 1; } .cols-2 { --cols: 2; } .cols-3 { --cols: 3; } .cols-4 { --cols: 4; }
    @media (max-width: 720px) {
      .stat-grid:not(.cols-1) dl { --cols: 2; }
    }

    /* Funciones: rejilla bento */
    .bento {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: minmax(14rem, auto);
      gap: 1rem;
    }
    .bento-card {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      min-width: 0;
      padding: clamp(1.5rem, 2.5vw, 2rem);
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--surface);
    }
    .s2 { grid-column: span 2; } .s3 { grid-column: span 3; } .s4 { grid-column: span 4; } .s6 { grid-column: span 6; }
    .r2 { grid-row: span 2; }
    .bento-icon {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 2.75rem;
      height: 2.75rem;
      margin-bottom: auto;
      border-radius: 12px;
      background: var(--bg);
      box-shadow: 0 0 0 1px var(--border), var(--shadow-sm);
      color: var(--primary-ink);
    }
    .bento-icon svg { width: 1.375rem; height: 1.375rem; }
    .bento-text { margin-top: auto; }
    .bento-card h3 { font-size: 1.1875rem; line-height: 1.25; letter-spacing: -0.025em; }
    .bento-card p { margin-top: 0.5rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.6; }
    .bento-card.s6:not(.is-big) { flex-direction: row; align-items: center; min-height: 0; }
    .bento-card.s6:not(.is-big) .bento-icon { margin-bottom: 0; }
    .bento-card.s6:not(.is-big) .bento-text { margin-top: 0; max-width: 44rem; }

    .is-big { border-color: transparent; background: var(--ink); color: #fff; }
    .is-big::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(60% 55% at 70% 30%, color-mix(in srgb, var(--primary) 34%, transparent), transparent 70%),
        linear-gradient(var(--ink-line) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
        linear-gradient(90deg, var(--ink-line) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem;
      -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 85%);
      mask-image: linear-gradient(to bottom, #000 35%, transparent 85%);
    }
    .is-big h3 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); letter-spacing: -0.035em; }
    .is-big p { color: rgb(255 255 255 / 0.7); font-size: 1rem; max-width: 34rem; }
    .big-visual { flex: 1; display: grid; place-items: center; min-height: 11rem; padding: 1.5rem 0 0.5rem; }
    .bv-panel {
      position: relative;
      display: grid;
      gap: 0.625rem;
      width: min(100%, 25rem);
      padding: 1.75rem 1.25rem 1.25rem;
      border-radius: 16px;
      background: rgb(255 255 255 / 0.06);
      box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1) inset, 0 30px 60px -30px rgb(0 0 0 / 0.7);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
    .bv-badge {
      position: absolute;
      top: -1.375rem;
      left: 1.25rem;
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 12px;
      background: var(--primary);
      color: var(--on-primary);
      box-shadow: 0 12px 28px -10px color-mix(in srgb, var(--primary) 85%, transparent);
    }
    .bv-badge svg { width: 1.375rem; height: 1.375rem; }
    .bv-row { display: grid; grid-template-columns: 1.5rem repeat(7, minmax(0, 1fr)); align-items: center; gap: 0.25rem; height: 1.625rem; }
    .bv-row i { width: 1.375rem; height: 1.375rem; border-radius: 50%; background: rgb(255 255 255 / 0.16); }
    .bv-row b {
      grid-row: 1;
      height: 1.125rem;
      border-radius: 6px;
      background: color-mix(in srgb, var(--primary) 30%, transparent);
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 55%, transparent) inset;
    }
    .bv-row b.hi { background: var(--primary); box-shadow: none; }
    .bv-row b.dim { background: rgb(255 255 255 / 0.1); box-shadow: none; }
    .is-big.s6 { flex-direction: row-reverse; align-items: center; gap: 2.5rem; }
    .is-big.s6 > * { flex: 1 1 0; }
    .is-big.s6 .bento-text { margin-top: 0; }

    @media (max-width: 960px) {
      .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
      .bento .bento-card { grid-column: span 1; grid-row: auto; min-height: 13rem; }
      .bento .is-big, .bento .t-full { grid-column: span 2; }
      .is-big.s6 { flex-direction: column; align-items: stretch; }
    }
    @media (max-width: 600px) {
      .bento { grid-template-columns: minmax(0, 1fr); }
      .bento .bento-card, .bento .is-big, .bento .t-full { grid-column: auto; min-height: 0; }
      .bento-card.s6:not(.is-big) { flex-direction: column; align-items: flex-start; }
      .bento-icon { margin-bottom: 0; }
    }

    /* Cómo funciona */
    .how { background: var(--surface); }
    .steps { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 3rem 1.5rem; }
    .step { position: relative; padding-top: 2.25rem; border-top: 1px solid var(--border); }
    .step-num {
      position: absolute;
      top: 0;
      left: 0;
      transform: translateY(-50%);
      display: inline-grid;
      place-items: center;
      min-width: 2.25rem;
      height: 2.25rem;
      max-width: 100%;
      padding: 0 0.75rem;
      border-radius: 999px;
      background: var(--bg);
      box-shadow: 0 0 0 1px var(--border);
      color: var(--primary-ink);
      font-family: var(--font-heading);
      font-size: 0.9375rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .step h3 { font-size: 1.25rem; line-height: 1.25; letter-spacing: -0.025em; }
    .step p { max-width: 38rem; margin-top: 0.5rem; color: var(--muted); }
    @media (max-width: 900px) {
      .steps.cols-4 { --cols: 2; }
    }
    @media (max-width: 640px) {
      .steps { --cols: 1 !important; gap: 2.75rem; }
    }

    /* Demo en vídeo */
    .demo { position: relative; isolation: isolate; overflow: hidden; background: var(--ink); color: #fff; }
    html.bi-dark .demo { border-block: 1px solid var(--border); }
    .demo::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(50% 45% at 50% 100%, color-mix(in srgb, var(--primary) 30%, transparent), transparent 75%),
        linear-gradient(var(--ink-line) 1px, transparent 1px) center / 4rem 4rem,
        linear-gradient(90deg, var(--ink-line) 1px, transparent 1px) center / 4rem 4rem;
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 60%, #000 30%, transparent 80%);
      mask-image: radial-gradient(ellipse 80% 70% at 50% 60%, #000 30%, transparent 80%);
    }
    .demo .eyebrow { color: var(--primary-on-dark); }
    .demo .title { color: #fff; }
    .demo .lead { color: rgb(255 255 255 / 0.7); }
    .demo-frame {
      max-width: 62rem;
      margin: 0 auto;
      padding: 0.4375rem;
      border-radius: 1.25rem;
      background: rgb(255 255 255 / 0.06);
      box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12) inset, 0 50px 100px -45px color-mix(in srgb, var(--primary) 70%, transparent);
    }
    .demo-frame .video-frame { border-radius: 0.8125rem; }

    /* Precios */
    /* Filas de tres (de cuatro si son 4 u 8) y la última centrada, todas del mismo ancho */
    .plans { --per: 3; display: flex; flex-wrap: wrap; justify-content: center; align-items: stretch; gap: 1.25rem; }
    .plans.n4 { --per: 4; }
    .plan {
      position: relative;
      display: flex;
      flex-direction: column;
      flex: 0 1 calc((100% - (var(--per) - 1) * 1.25rem) / var(--per));
      min-width: 0;
      max-width: 26rem;
      padding: clamp(1.5rem, 2.5vw, 2rem);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--bg);
    }
    .plan-media { aspect-ratio: 16 / 9; margin-bottom: 1.5rem; overflow: hidden; border-radius: 12px; }
    .plan-media > * { width: 100%; height: 100%; object-fit: cover; }
    .plan-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 0.75rem; }
    .plan h3 { font-size: 1.125rem; letter-spacing: -0.02em; }
    .plan-badge {
      padding: 0.25rem 0.625rem;
      border-radius: 999px;
      background: var(--primary-soft);
      color: var(--primary-ink);
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .plan-price {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.125rem 0.375rem;
      margin-top: 1.25rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .plan-top + .plan-list, .plan-top + .plan-desc { margin-top: 1.25rem; }
    .amount {
      font-family: var(--font-heading);
      font-size: clamp(2.375rem, 1.9rem + 1.5vw, 3.125rem);
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.05em;
      font-variant-numeric: tabular-nums;
    }
    .amount.is-long { font-size: clamp(1.875rem, 1.6rem + 0.8vw, 2.25rem); letter-spacing: -0.04em; }
    .per { color: var(--muted); font-size: 0.9375rem; font-weight: 500; }
    .plan-list { flex: 1; margin-top: 1.5rem; font-size: 0.9375rem; line-height: 1.5; }
    .plan-desc { flex: 1; margin-top: 1.5rem; color: var(--muted); font-size: 0.9375rem; }
    .plan-btn { width: 100%; margin-top: 2rem; }
    .plan > :last-child:not(.plan-btn) { margin-bottom: 0; }
    .is-featured {
      border-color: color-mix(in srgb, var(--primary) 70%, transparent);
      background: var(--ink);
      color: #fff;
      box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--primary) 65%, transparent);
    }
    .is-featured .plan-badge { background: var(--primary); color: var(--on-primary); }
    .is-featured .per, .is-featured .plan-desc { color: rgb(255 255 255 / 0.68); }
    .is-featured .plan-price { border-color: var(--ink-line); }
    .is-featured .checklist li svg { color: var(--primary-on-dark); }
    .is-featured .btn-primary { box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18) inset; }
    @media (max-width: 960px) { .plans, .plans.n4 { --per: 2; } }
    @media (max-width: 640px) {
      .plans, .plans.n4 { --per: 1; }
      .plan { max-width: none; }
    }

    /* Clientes: rejilla de 6 columnas (filas de tres; la primera, destacada, si sobra una) */
    .voices { background: var(--surface); }
    .wall { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.25rem; }
    .wall .w2 { grid-column: span 2; } .wall .w3 { grid-column: span 3; } .wall .w6 { grid-column: span 6; }
    .voice {
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding: clamp(1.5rem, 2.5vw, 1.875rem);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--bg);
    }
    .voice > svg { width: 1.5rem; height: 1.5rem; margin-bottom: 1rem; color: var(--primary-ink); }
    .voice blockquote { flex: 1; font-size: 1.0625rem; line-height: 1.6; }
    .voice figcaption { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.5rem; }
    .voice .avatar { width: 2.5rem; height: 2.5rem; font-size: 0.875rem; }
    .voice.w6 { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 1.5rem; padding: clamp(1.75rem, 4vw, 2.75rem); }
    .voice.w6 > svg { width: 2rem; height: 2rem; margin: 0.25rem 0 0; }
    .voice.w6 blockquote {
      font-family: var(--font-heading);
      font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
      font-weight: 500;
      line-height: 1.35;
      letter-spacing: -0.025em;
    }
    .voice.w6 figcaption { grid-column: 2; }
    .who { min-width: 0; line-height: 1.35; }
    .who strong { display: block; font-size: 0.9375rem; font-weight: 600; }
    .who span { display: block; color: var(--muted); font-size: 0.875rem; }
    .voice-solo { max-width: 50rem; margin: 0 auto; text-align: center; }
    .voice-solo > svg { width: 2rem; height: 2rem; margin: 0 auto 1.5rem; color: var(--primary-ink); }
    .voice-solo blockquote {
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: -0.03em;
      text-wrap: balance;
    }
    .voice-solo figcaption { display: inline-flex; align-items: center; gap: 0.875rem; margin-top: 2rem; text-align: left; }
    @media (max-width: 960px) {
      .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .wall .voice { grid-column: span 1; }
      .wall .w6, .wall .t-full { grid-column: span 2; }
    }
    @media (max-width: 640px) {
      .wall { grid-template-columns: minmax(0, 1fr); }
      .wall .voice, .wall .w6, .wall .t-full { grid-column: auto; }
      .voice.w6 { display: flex; }
      .voice.w6 > svg { margin-bottom: 1rem; }
    }

    /* Preguntas */
    .faq-list { display: grid; gap: 0.75rem; max-width: 48rem; margin: 0 auto; }
    .faq-item {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .faq-item[open] { border-color: color-mix(in srgb, var(--primary) 45%, var(--border)); box-shadow: 0 0 0 4px var(--primary-soft); }
    .faq-item > summary { padding: 1.125rem 1.25rem; font-size: 1.0625rem; font-weight: 600; line-height: 1.4; letter-spacing: -0.01em; }
    .faq-item > summary .faq-icon {
      width: 1.75rem;
      height: 1.75rem;
      padding: 0.3rem;
      border-radius: 50%;
      background: var(--surface);
      color: var(--primary-ink);
    }
    .faq-answer { padding: 0 3.75rem 1.25rem 1.25rem; color: var(--muted); }
    @media (max-width: 600px) { .faq-answer { padding-right: 1.25rem; } }

    /* Llamada final */
    .cta-panel {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: clamp(3.5rem, 8vw, 6.5rem) clamp(1.25rem, 5vw, 4rem);
      border-radius: 1.75rem;
      background: var(--ink);
      color: #fff;
      text-align: center;
    }
    html.bi-dark .cta-panel { box-shadow: 0 0 0 1px var(--border) inset; }
    .cta-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(55% 60% at 50% 115%, color-mix(in srgb, var(--primary) 55%, transparent), transparent 70%),
        linear-gradient(var(--ink-line) 1px, transparent 1px) center / 3.5rem 3.5rem,
        linear-gradient(90deg, var(--ink-line) 1px, transparent 1px) center / 3.5rem 3.5rem;
      -webkit-mask-image: radial-gradient(ellipse 85% 85% at 50% 100%, #000 35%, transparent 85%);
      mask-image: radial-gradient(ellipse 85% 85% at 50% 100%, #000 35%, transparent 85%);
    }
    .cta-title {
      max-width: 20ch;
      margin: 0 auto;
      font-size: clamp(2.125rem, 1.3rem + 3.2vw, 4rem);
      line-height: 1.04;
      letter-spacing: -0.045em;
    }
    .cta-panel p { max-width: 36rem; margin: 1.25rem auto 0; color: rgb(255 255 255 / 0.72); font-size: 1.125rem; }
    .cta-panel .actions { justify-content: center; margin-top: 2.25rem; }
    .cta-panel .btn-primary { box-shadow: 0 0 0 1px rgb(255 255 255 / 0.2) inset, 0 14px 30px -12px color-mix(in srgb, var(--primary) 90%, transparent); }

    /* Contacto */
    .reach { background: var(--surface); }
    .reach-grid { display: grid; gap: 2rem 4rem; }
    .reach-grid .section-head { margin-bottom: 0; }
    @media (min-width: 900px) {
      .reach-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; }
    }
    .channels { border-top: 1px solid var(--border); }
    .channel {
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr) auto;
      align-items: center;
      gap: 1rem;
      padding: 1.125rem 0;
      border-bottom: 1px solid var(--border);
    }
    .ch-icon {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 12px;
      background: var(--bg);
      box-shadow: 0 0 0 1px var(--border);
      color: var(--primary-ink);
    }
    .ch-icon svg { width: 1.25rem; height: 1.25rem; }
    .ch-label { display: block; color: var(--muted); font-size: 0.8125rem; line-height: 1.3; }
    .ch-value { display: block; font-weight: 500; line-height: 1.45; overflow-wrap: anywhere; }
    .ch-value span { display: block; }
    .ch-go { width: 1.125rem; height: 1.125rem; color: var(--muted); transition: transform 0.2s var(--ease), color 0.2s; }
    a.channel:hover .ch-value { color: var(--primary-ink); }
    a.channel:hover .ch-go { color: var(--primary-ink); transform: translate(2px, -2px); }

    /* Pie */
    .site-footer { padding: clamp(3.5rem, 7vw, 5rem) 0 2rem; border-top: 1px solid var(--border); }
    .footer-top { display: grid; gap: 2rem; }
    @media (min-width: 820px) { .footer-top { grid-template-columns: minmax(0, 1fr) auto; align-items: start; } }
    .footer-brand { display: inline-flex; align-items: center; gap: 0.625rem; max-width: 100%; font-family: var(--font-heading); font-size: 1.375rem; font-weight: 650; line-height: 1.2; letter-spacing: -0.03em; }
    .footer-brand img { width: auto; height: 2.25rem; max-width: 12rem; object-fit: contain; }
    .footer-text { max-width: 26rem; margin-top: 0.875rem; color: var(--muted); font-size: 0.9375rem; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 0.625rem 1.75rem; max-width: 34rem; font-size: 0.9375rem; font-weight: 500; }
    .footer-links a { color: var(--muted); transition: color 0.2s; }
    .footer-links a:hover { color: var(--text); }
    .footer-bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.75rem 2rem;
      margin-top: clamp(2.5rem, 5vw, 4rem);
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.875rem;
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main"><%= t("skip") %></a>

  <%
    // Cabecera de sección: "center", "split" (título a la izquierda y entradilla a la derecha) o a la izquierda
    function sectionHead(key, variant) {
      const h = heading(key);
      if (!h.eyebrow && !h.title && !h.subtitle) return;
      if (variant === "split") {
  %>
    <div class="section-head head-split">
      <% if (h.eyebrow || h.title) { %>
      <div>
        <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
        <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
      </div>
      <% } %>
      <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
    </div>
  <%  } else { %>
    <div class="section-head <%= variant || '' %>">
      <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
      <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
      <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
    </div>
  <%  }
    }

    // Columnas para listas cortas sin huérfanos raros: 5 y 6 en tres, 7 y 8 en cuatro
    const colsFor = (n) => (n <= 4 ? n : n % 3 === 0 || n === 5 ? 3 : 4);
    const hero = config.hero;
    const c = config.contact;
    const brandName = config.brand.name;
    const markLetter = initials(brandName).slice(0, 1);

    function brandMark() {
      if (config.brand.logo) { %><%- img(config.brand.logo, brandName, { eager: true, sizes: "160px", width: 480 }) %><% return; }
      if (markLetter) { %><span class="brand-mark" aria-hidden="true"><%= markLetter %></span><% }
    }
  %>

  <header class="site-header" data-section="brand">
    <div class="container nav">
      <a class="brand" href="#main">
        <% brandMark() %>
        <% if (brandName) { %><span><%= brandName %></span><% } %>
      </a>
      <%- navLinks({ limit: 5, exclude: ["contact"] }) %>
      <% if (hero.ctaText && show("hero")) { %>
        <a class="btn btn-primary btn-sm nav-cta" <%- linkAttrs(hero.ctaLink) %>><%= hero.ctaText %></a>
      <% } %>
      <%- mobileMenu({ cta: show("hero") ? { text: hero.ctaText, href: hero.ctaLink } : undefined }) %>
    </div>
  </header>

  <main id="main">
    <% if (show("hero")) { const longTitle = hero.title.length > 70; %>
    <section class="hero" id="hero" data-section="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-inner">
        <% if (hero.eyebrow) { %>
          <p class="pill rise"><span class="pill-tag"><%- icon("sparkles", "") %></span><span><%= hero.eyebrow %></span></p>
        <% } %>
        <% if (hero.title) { %><h1 class="hero-title rise-2<%= longTitle ? ' is-long' : '' %>"><%= hero.title %></h1><% } %>
        <% if (hero.subtitle) { %><p class="hero-sub rise-3"><%= hero.subtitle %></p><% } %>
        <% if (hero.ctaText || hero.secondaryCtaText) { %>
        <div class="actions hero-actions rise-3">
          <% if (hero.ctaText) { %><a class="btn btn-primary btn-lg" <%- linkAttrs(hero.ctaLink) %>><%= hero.ctaText %></a><% } %>
          <% if (hero.secondaryCtaText) { %>
            <a class="btn btn-outline btn-lg" <%- linkAttrs(hero.secondaryCtaLink) %>><% if (hero.secondaryCtaLink === "#video") { %><%- icon("play", "") %><% } %><%= hero.secondaryCtaText %></a>
          <% } %>
        </div>
        <% } %>

        <figure class="product rise-3">
          <div class="window">
            <div class="window-bar" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <% if (brandName) { %><span class="url"><%- icon("lock", "") %><span><%= brandName %></span></span><% } else { %><span></span><% } %>
            </div>
            <div class="window-body">
              <% if (hero.backgroundImage) { %>
                <%- img(hero.backgroundImage, t("screenshot"), { eager: true, sizes: "(min-width: 1140px) 1090px, 96vw", width: 2000 }) %>
              <% } else { %>
                <%
                  // Planificador semanal: [columna inicial, columna final, estilo] por fila
                  const rows = [
                    [[2, 4, ""], [6, 8, "alt"]],
                    [[3, 6, "hi"]],
                    [[2, 3, "alt"], [4, 7, ""]],
                    [[5, 9, ""]],
                    [[2, 5, ""], [7, 9, "alt"]],
                    [[3, 5, "alt"], [6, 8, ""]],
                    [[2, 4, "alt"], [5, 7, ""]],
                  ];
                %>
                <div class="mock" aria-hidden="true">
                  <div class="mock-side">
                    <i class="m-logo"></i><i class="m-nav is-on"></i><i class="m-nav"></i><i class="m-nav"></i><i class="m-nav"></i><i class="m-nav"></i><i class="m-user"></i>
                  </div>
                  <div class="mock-main">
                    <div class="mock-top"><i class="m-title"></i><i class="m-sub"></i><i class="m-seg"></i><i class="m-btn"></i></div>
                    <div class="mock-cal">
                      <div class="m-head"><span></span><i></i><i></i><i class="is-today"></i><i></i><i></i><i></i><i></i></div>
                      <% rows.forEach((row) => { %>
                        <div class="m-row">
                          <span class="m-person"><i class="m-av"></i><i class="m-name"></i></span>
                          <% row.forEach(([a, b, kind]) => { %><b class="<%= kind %>" style="grid-column: <%= a %> / <%= b %>"></b><% }) %>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                  <div class="mock-toast"><span class="m-check"><%- icon("check", "") %></span><span class="m-lines"><i></i><i></i></span></div>
                </div>
              <% } %>
            </div>
          </div>
        </figure>
      </div>
    </section>
    <% } %>

    <% if (show("stats")) { const st = config.stats; %>
    <section class="stats" id="stats" data-section="stats">
      <div class="container">
        <% sectionHead("stats", "center") %>
        <div class="stat-grid cols-<%= colsFor(st.length) %>">
          <dl>
            <% st.forEach((s) => { %>
              <div class="stat">
                <dt><%= s.label %></dt>
                <dd><%= s.value %></dd>
              </div>
            <% }) %>
          </dl>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("features")) {
         const fs = config.features;
         const n = fs.length;
         // Rejilla bento de 6 columnas: la primera función manda (4 columnas y 2 filas)
         // y el resto se reparte en filas completas, sin huecos sueltos.
         const spans = [];
         if (n === 1) spans.push("s6");
         else if (n === 2) spans.push("s3", "s3");
         else {
           spans.push("s4 r2", "s2", "s2");
           let rest = n - 3;
           while (rest > 0) {
             if (rest === 1) { spans.push("s6"); rest = 0; }
             else if (rest === 2) { spans.push("s3", "s3"); rest = 0; }
             else if (rest === 4) { spans.push("s3", "s3", "s3", "s3"); rest = 0; }
             else { spans.push("s2", "s2", "s2"); rest -= 3; }
           }
         }
         // En tableta (2 columnas) la primera ocupa toda la fila; si sobra una al final, también
         const oddTail = n > 1 && (n - 1) % 2 === 1;
         const bars = [[[2, 4, ""], [6, 8, "dim"]], [[3, 6, "hi"]], [[2, 3, "dim"], [4, 7, ""]], [[5, 9, ""]]];
    %>
    <section class="section" id="features" data-section="features">
      <div class="container">
        <% sectionHead("features", "split") %>
        <ul class="bento">
          <% fs.forEach((f, i) => { const big = i === 0; %>
            <li class="bento-card <%= spans[i] %><%= big ? ' is-big' : '' %><%= oddTail && i === n - 1 ? ' t-full' : '' %>">
              <% if (big) { %>
                <div class="big-visual" aria-hidden="true">
                  <div class="bv-panel">
                    <% if (f.icon) { %><span class="bv-badge"><%- icon(f.icon) %></span><% } %>
                    <% bars.forEach((row) => { %>
                      <span class="bv-row"><i></i><% row.forEach(([a, b, kind]) => { %><b class="<%= kind %>" style="grid-column: <%= a %> / <%= b %>"></b><% }) %></span>
                    <% }) %>
                  </div>
                </div>
              <% } else if (f.icon) { %>
                <span class="bento-icon"><%- icon(f.icon) %></span>
              <% } %>
              <% if (f.title || f.description) { %>
              <div class="bento-text">
                <% if (f.title) { %><h3><%= f.title %></h3><% } %>
                <% if (f.description) { %><p><%= f.description %></p><% } %>
              </div>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% } %>

    <% if (show("steps")) { const ss = config.steps; %>
    <section class="section how" id="steps" data-section="steps">
      <div class="container">
        <% sectionHead("steps", "split") %>
        <ol class="steps cols-<%= colsFor(ss.length) %>">
          <% ss.forEach((s, i) => { %>
            <li class="step">
              <span class="step-num"><%= s.label || i + 1 %></span>
              <% if (s.title) { %><h3><%= s.title %></h3><% } %>
              <% if (s.description) { %><p><%= s.description %></p><% } %>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>
    <% } %>

    <% if (show("video")) { %>
    <section class="section demo" id="video" data-section="video">
      <div class="container">
        <% sectionHead("video", "center") %>
        <div class="demo-frame"><%- video(config.video.url, config.video.thumbnail, heading("video").title || brandName) %></div>
      </div>
    </section>
    <% } %>

    <% if (show("products")) {
         const ps = config.products;
         const featuredIdx = ps.findIndex((p) => p.badge);
         const withMedia = ps.some((p) => p.image);
    %>
    <section class="section" id="products" data-section="products">
      <div class="container">
        <% sectionHead("products", "center") %>
        <ul class="plans<%= ps.length % 4 === 0 && ps.length % 3 !== 0 ? ' n4' : '' %>">
          <% ps.forEach((p, i) => {
               const featured = i === featuredIdx;
               const items = lines(p.description);
               // «19 €/mes» → importe grande y periodo pequeño
               const cut = p.price.indexOf("/");
               // sin separar la cifra de su moneda
               const amount = (cut > 0 ? p.price.slice(0, cut).trim() : p.price).replace(/\s+(€|\$|£)/g, "\u00a0$1");
               const per = cut > 0 ? p.price.slice(cut).trim() : "";
          %>
            <li class="plan<%= featured ? ' is-featured' : '' %>">
              <% if (withMedia) { %><div class="plan-media"><%- img(p.image, p.title, { sizes: "(min-width: 900px) 360px, 100vw", width: 800 }) %></div><% } %>
              <% if (p.title || p.badge) { %>
              <div class="plan-top">
                <% if (p.title) { %><h3><%= p.title %></h3><% } %>
                <% if (p.badge) { %><span class="plan-badge"><%= p.badge %></span><% } %>
              </div>
              <% } %>
              <% if (p.price) { %>
                <p class="plan-price"><span class="amount<%= amount.length > 6 ? ' is-long' : '' %>"><%= amount %></span><% if (per) { %><span class="per"><%= per %></span><% } %></p>
              <% } %>
              <% if (items.length > 1) { %>
                <ul class="checklist plan-list"><% items.forEach((item) => { %><li><%- icon("check", "") %><%= item %></li><% }) %></ul>
              <% } else if (items.length) { %>
                <p class="plan-desc"><%= items[0] %></p>
              <% } %>
              <% if (p.link) { %>
                <a class="btn <%= featured ? 'btn-primary' : 'btn-outline' %> plan-btn" <%- linkAttrs(p.link) %>><%= t("choosePlan") %></a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% } %>

    <% if (show("testimonials")) { const ts = config.testimonials; %>
    <section class="section voices" id="testimonials" data-section="testimonials">
      <div class="container">
        <% sectionHead("testimonials", "split") %>
        <% function author(r) { %>
          <span class="avatar"><% if (r.avatar) { %><%- img(r.avatar, r.name, { sizes: "48px", width: 480 }) %><% } else { %><%= initials(r.name) %><% } %></span>
          <span class="who"><% if (r.name) { %><strong><%= r.name %></strong><% } %><% if (r.role) { %><span><%= r.role %></span><% } %></span>
        <% } %>
        <% if (ts.length === 1) { const r = ts[0]; %>
          <figure class="voice-solo">
            <%- icon("quote", "") %>
            <% if (r.quote) { %><blockquote><%= r.quote %></blockquote><% } %>
            <% if (r.name || r.role) { %><figcaption><% author(r) %></figcaption><% } %>
          </figure>
        <% } else { %>
          <%
            // 3k → filas de tres; 3k+1 → la primera destacada a lo ancho; 3k+2 → las dos primeras a medias
            const nT = ts.length;
            const head = nT % 3 === 1 ? ["w6"] : nT % 3 === 2 ? ["w3", "w3"] : [];
            const wide = ts.map((_, i) => head[i] || "w2");
            // En tableta (2 columnas): la destacada a lo ancho y, si sobra una al final, también
            const rest = nT - (wide[0] === "w6" ? 1 : 0);
          %>
          <div class="wall">
            <% ts.forEach((r, i) => { %>
              <figure class="voice <%= wide[i] %><%= i === nT - 1 && rest % 2 === 1 && wide[i] !== 'w6' ? ' t-full' : '' %>">
                <%- icon("quote", "") %>
                <% if (r.quote) { %><blockquote><%= r.quote %></blockquote><% } %>
                <% if (r.name || r.role) { %><figcaption><% author(r) %></figcaption><% } %>
              </figure>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (show("faqs")) { %>
    <section class="section" id="faqs" data-section="faqs">
      <div class="container">
        <% sectionHead("faqs", "center") %>
        <div class="faq-list">
          <% config.faqs.forEach((f, i) => { %>
            <details class="faq-item"<%= i === 0 ? " open" : "" %>>
              <summary><span><%= f.question || t("question") %></span><%- icon("plus", "faq-icon") %></summary>
              <% if (f.answer) { %><div class="faq-answer"><%- paras(f.answer) %></div><% } %>
            </details>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("cta")) { const cta = config.cta; %>
    <section class="section" id="cta" data-section="cta">
      <div class="container">
        <div class="cta-panel">
          <% if (cta.title) { %><h2 class="cta-title"><%= cta.title %></h2><% } %>
          <% if (cta.text) { %><p><%= cta.text %></p><% } %>
          <% if (cta.buttonText) { %>
            <div class="actions"><a class="btn btn-primary btn-lg" <%- linkAttrs(cta.buttonLink) %>><%= cta.buttonText %></a></div>
          <% } %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("contact")) { const hourLines = lines(c.hours); %>
    <section class="section reach" id="contact" data-section="contact">
      <div class="container reach-grid">
        <div><% sectionHead("contact") %></div>
        <div class="channels">
          <% if (c.email) { %>
            <a class="channel" href="<%= mailHref(c.email) || '#' %>">
              <span class="ch-icon"><%- icon("mail") %></span>
              <span><span class="ch-label"><%= t("email") %></span><span class="ch-value"><%= c.email %></span></span>
              <%- icon("arrow-up-right", "ch-go") %>
            </a>
          <% } %>
          <% if (c.phone) { %>
            <a class="channel" href="<%= telHref(c.phone) || '#' %>">
              <span class="ch-icon"><%- icon("phone") %></span>
              <span><span class="ch-label"><%= t("phone") %></span><span class="ch-value"><%= c.phone %></span></span>
              <%- icon("arrow-up-right", "ch-go") %>
            </a>
          <% } %>
          <% if (c.whatsapp) { %>
            <a class="channel" <%- linkAttrs(waHref(c.whatsapp)) %>>
              <span class="ch-icon"><%- icon("message-circle") %></span>
              <span><span class="ch-label"><%= t("whatsapp") %></span><span class="ch-value"><%= c.whatsapp %></span></span>
              <%- icon("arrow-up-right", "ch-go") %>
            </a>
          <% } %>
          <% if (c.address) { %>
            <a class="channel" <%- linkAttrs(mapsHref(c.address)) %>>
              <span class="ch-icon"><%- icon("map-pin") %></span>
              <span><span class="ch-label"><%= t("address") %></span><span class="ch-value"><%= c.address %></span></span>
              <%- icon("arrow-up-right", "ch-go") %>
            </a>
          <% } %>
          <% if (hourLines.length) { %>
            <div class="channel">
              <span class="ch-icon"><%- icon("clock") %></span>
              <span><span class="ch-label"><%= t("hours") %></span><span class="ch-value"><% hourLines.forEach((line) => { %><span><%= line %></span><% }) %></span></span>
            </div>
          <% } %>
        </div>
      </div>
    </section>
    <% } %>
  </main>

  <% if (show("footer")) { %>
  <footer class="site-footer" id="footer" data-section="footer">
    <div class="container">
      <div class="footer-top">
        <div>
          <p class="footer-brand"><% brandMark() %><% if (brandName) { %><span><%= brandName %></span><% } %></p>
          <% if (config.footer.text) { %><p class="footer-text"><%= config.footer.text %></p><% } %>
        </div>
        <% if (config.footer.links.length) { %>
        <nav class="footer-links" aria-label="<%= brandName || t('menu') %>">
          <% config.footer.links.forEach((l) => { %><a <%- linkAttrs(l.url) %>><%= l.label || l.url %></a><% }) %>
        </nav>
        <% } %>
      </div>
      <div class="footer-bottom">
        <p><%- copyright(brandName) %></p>
        <%- madeWith %>
      </div>
    </div>
  </footer>
  <% } %>

  <%- foot %>
</body>
</html>
