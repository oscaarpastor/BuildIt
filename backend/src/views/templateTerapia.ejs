<!DOCTYPE html>
<html <%- htmlAttrs %>>
<head>
  <%- head %>
  <style>
    /* Terapia: serena y cálida. Lora en titulares, Nunito Sans en el texto,
       verde salvia (principal) y arena (secundario). Formas redondeadas, mucho
       aire y un motivo propio: anillos concéntricos que recuerdan a una
       respiración pausada, detrás de la foto de portada y en la llamada final. */
    :root {
      --bg: #fbf9f5;
      --surface: #f4eee4;
      --surface-2: #ebe3d5;
      --text: #233029;
      --muted: #5b6861;
      --border: #e4dccf;
      --radius-sm: 12px;
      --radius: 20px;
      --radius-lg: 32px;
      --radius-btn: 999px;
      --header-h: 4.75rem;
      --sand: color-mix(in srgb, var(--secondary) 62%, var(--bg));
      --card: #ffffff;
      --ring: color-mix(in srgb, var(--primary) 42%, transparent);
    }
    html.bi-dark {
      --bg: #121614;
      --surface: #19201c;
      --surface-2: #222a25;
      --text: #e8ede9;
      --muted: #a3afa7;
      --border: #2b342e;
      --sand: color-mix(in srgb, var(--secondary) 7%, var(--surface));
      --card: #1c231f;
      --ring: color-mix(in srgb, var(--primary-ink) 30%, transparent);
    }

    h1, h2, h3 { font-weight: 500; letter-spacing: -0.01em; }
    .title { font-size: clamp(2rem, 1.45rem + 2.2vw, 3.125rem); line-height: 1.15; font-weight: 500; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
      padding: 0.375rem 0.875rem;
      border-radius: 999px;
      background: var(--primary-soft);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      text-transform: none;
    }
    .eyebrow::before { content: ""; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--primary); flex-shrink: 0; }
    .section-head { max-width: 40rem; }
    .lead { line-height: 1.65; }
    .btn { font-weight: 700; }
    .btn-outline { border-color: color-mix(in srgb, var(--text) 25%, transparent); }

    /* Rejilla de elementos iguales: la última fila incompleta queda centrada */
    .flow { --cols: 1; --gap: clamp(1rem, 2vw, 1.5rem); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap); }
    .flow > * { flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols) - 0.05px); min-width: 0; }
    .flow.c1 > * { flex-basis: min(100%, 34rem); }
    .flow.c2 { --cols: 2; }
    .flow.c3 { --cols: 3; }
    .flow.c4 { --cols: 4; }
    @media (max-width: 1100px) { .flow.c4 { --cols: 2; } }
    @media (max-width: 900px) { .flow.c3 { --cols: 2; } }
    @media (max-width: 620px) { .flow.c2, .flow.c3, .flow.c4 { --cols: 1; } }

    /* ---------- Cabecera ---------- */
    .site-header .brand { gap: 0.625rem; font-size: 1.25rem; font-weight: 500; }
    .brand-mark { flex-shrink: 0; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: radial-gradient(circle, var(--primary) 0 28%, transparent 30% 48%, var(--primary) 50% 58%, transparent 60%); opacity: 0.9; }
    .nav-links a { color: var(--muted); }
    .nav-links a:hover { color: var(--primary-ink); }

    /* ---------- Portada ---------- */
    .hero { position: relative; overflow: hidden; padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem); }
    .hero-grid { display: grid; gap: clamp(3.5rem, 8vw, 6rem); align-items: center; }
    .hero-copy { min-width: 0; max-width: 38rem; }
    .hero-title { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem); font-weight: 500; line-height: 1.08; letter-spacing: -0.02em; }
    .hero-title.t-m { font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem); }
    .hero-title.t-l { font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.75rem); line-height: 1.15; }
    .hero-sub { margin-top: 1.5rem; color: var(--muted); font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.65; }
    .hero .actions { margin-top: 2.25rem; }
    .hero-figure { position: relative; isolation: isolate; justify-self: center; width: min(100%, 27rem); aspect-ratio: 4 / 5; }
    /* Anillos de respiración */
    .rings {
      position: absolute;
      z-index: -2;
      left: 50%;
      top: 50%;
      width: 175%;
      aspect-ratio: 1;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: repeating-radial-gradient(circle at center, transparent 0 calc(2.75rem - 1px), var(--ring) calc(2.75rem - 1px) 2.75rem);
      -webkit-mask-image: radial-gradient(circle, #000 30%, transparent 70%);
      mask-image: radial-gradient(circle, #000 30%, transparent 70%);
      pointer-events: none;
    }
    .hero-figure::after {
      content: "";
      position: absolute;
      z-index: -1;
      width: 46%;
      aspect-ratio: 1;
      left: -14%;
      bottom: -4%;
      border-radius: 50%;
      background: var(--sand);
    }
    .hero-oval { width: 100%; height: 100%; border-radius: 50%; overflow: hidden; background: var(--surface-2); }
    .hero-oval > img { width: 100%; height: 100%; object-fit: cover; }
    .hero-figure.empty::after { width: 62%; left: 19%; bottom: 19%; background: var(--primary-soft); }
    @media (min-width: 940px) {
      .hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
      .hero-figure { justify-self: end; margin-right: 2rem; }
    }
    @media (max-width: 939px) {
      .hero-figure { width: min(80%, 22rem); }
      .hero-figure.empty { display: none; }
    }

    /* ---------- Sobre mí ---------- */
    .about-grid { display: grid; gap: clamp(3rem, 7vw, 6rem); align-items: center; }
    .about-media { position: relative; isolation: isolate; width: min(100%, 30rem); }
    .about-media::before { content: ""; position: absolute; z-index: -1; inset: 2.5rem -1.75rem -1.75rem 2.5rem; border-radius: var(--radius-lg); background: var(--sand); }
    @media (max-width: 600px) { .about-media { width: calc(100% - 1rem); } .about-media::before { inset: 1.5rem -1rem -1rem 1.5rem; } }
    .about-frame { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; background: var(--surface-2); }
    .about-frame > * { width: 100%; height: 100%; object-fit: cover; }
    .about-title { font-size: clamp(2.25rem, 1.5rem + 2.8vw, 3.5rem); font-weight: 500; line-height: 1.1; }
    .about-copy .lead { margin-top: 1rem; }
    .about-copy .prose { margin-top: 1.5rem; color: var(--muted); font-size: 1.0625rem; line-height: 1.75; max-width: 36rem; }
    @media (min-width: 900px) {
      .about-grid.two { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); }
    }

    /* ---------- Especialidades ---------- */
    .sand { background: var(--sand); }
    .spec { display: flex; flex-direction: column; padding: clamp(1.75rem, 3vw, 2.25rem); border-radius: var(--radius-lg); background: var(--card); }
    .spec-icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; margin-bottom: 1.5rem; border-radius: 50%; background: var(--primary-soft); color: var(--primary-ink); }
    .spec h3 { font-size: 1.3125rem; line-height: 1.3; }
    .spec p { margin-top: 0.625rem; color: var(--muted); line-height: 1.6; }

    /* ---------- Cómo trabajo ---------- */
    .path { position: relative; display: grid; gap: 0; max-width: 46rem; }
    .path-step { position: relative; display: grid; grid-template-columns: 3.25rem minmax(0, 1fr); align-content: start; gap: 0 1.5rem; padding-bottom: 2.5rem; }
    .path-step:last-child { padding-bottom: 0; }
    .path-step::before { content: ""; position: absolute; left: calc(1.625rem - 1px); top: 3.25rem; bottom: 0; border-left: 2px dotted color-mix(in srgb, var(--primary) 45%, transparent); }
    .path-step:last-child::before { display: none; }
    .marker {
      display: grid;
      place-items: center;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 50%;
      background: var(--bg);
      border: 1.5px solid var(--primary);
      color: var(--primary-ink);
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 500;
    }
    .marker.dot::after { content: ""; width: 0.625rem; height: 0.625rem; border-radius: 50%; background: var(--primary); }
    .step-label { display: inline-block; margin-bottom: 0.375rem; color: var(--primary-ink); font-size: 0.875rem; font-weight: 700; }
    .path-step h3 { padding-top: 0.6rem; font-size: 1.375rem; line-height: 1.3; }
    .path-step .step-label + h3 { padding-top: 0; }
    .path-step p { margin-top: 0.5rem; color: var(--muted); }
    .path-body { min-width: 0; }
    .label-first .path-body { padding-top: 0.75rem; }
    /* Hasta cuatro pasos: en horizontal en pantallas anchas */
    @media (min-width: 900px) {
      .path.row { max-width: none; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 2rem; }
      .path.row .path-step { grid-template-columns: minmax(0, 1fr); padding-bottom: 0; }
      .path.row .path-step::before { left: 4.25rem; right: -1rem; top: calc(1.625rem - 1px); bottom: auto; border-left: 0; border-top: 2px dotted color-mix(in srgb, var(--primary) 45%, transparent); }
      .path.row .path-body { margin-top: 1.5rem; padding-top: 0; }
      .path.row h3 { padding-top: 0; }
    }

    /* ---------- Sesiones ---------- */
    .plan { position: relative; display: flex; flex-direction: column; padding: clamp(1.75rem, 3vw, 2.25rem); border-radius: var(--radius-lg); background: var(--card); border: 1.5px solid transparent; }
    .plan.featured { border-color: var(--primary); }
    .plan-badge { position: absolute; top: 0; left: clamp(1.75rem, 3vw, 2.25rem); transform: translateY(-50%); padding: 0.3rem 0.875rem; border-radius: 999px; background: var(--primary); color: var(--on-primary); font-size: 0.8125rem; font-weight: 700; line-height: 1.3; }
    .plan-media { margin: calc(clamp(1.75rem, 3vw, 2.25rem) * -1) calc(clamp(1.75rem, 3vw, 2.25rem) * -1) 1.5rem; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
    .plan-media > * { width: 100%; height: 100%; object-fit: cover; }
    .plan h3 { font-family: var(--font-body); font-size: 1.0625rem; font-weight: 700; letter-spacing: 0; }
    .plan-price { margin-top: 0.5rem; font-family: var(--font-heading); font-size: clamp(2.25rem, 1.9rem + 1vw, 2.75rem); font-weight: 500; line-height: 1.1; overflow-wrap: anywhere; }
    .plan-price.small { font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem); }
    .plan .checklist { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.975rem; }
    .plan .btn { width: 100%; margin-top: 1.75rem; }
    .plan .plan-end { margin-top: auto; }

    /* ---------- Opiniones ---------- */
    .voice { display: flex; flex-direction: column; padding: 0.5rem 0.25rem; }
    .voice .quote-icon { width: 2rem; height: 2rem; color: var(--primary-ink); opacity: 0.8; }
    .voice blockquote { flex: 1; margin-top: 1rem; font-family: var(--font-heading); font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem); font-style: italic; line-height: 1.55; }
    .voice figcaption { display: flex; align-items: center; gap: 0.875rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
    .voice .avatar { background: var(--primary-soft); color: var(--primary-ink); font-size: 0.9375rem; }
    .voice strong { display: block; font-weight: 700; }
    .voice span.role { color: var(--muted); font-size: 0.9375rem; }
    .reviews .flow { --gap: clamp(1.5rem, 3vw, 3rem); row-gap: clamp(2.5rem, 4vw, 3rem); }

    /* ---------- Preguntas ---------- */
    .faq-wrap { max-width: 50rem; margin-inline: auto; }
    .faq-list { display: grid; gap: 0.75rem; }
    .faq-item { border-radius: var(--radius); background: var(--card); }
    .faq-item > summary { padding: 1.25rem 1.5rem; font-family: var(--font-heading); font-size: 1.1875rem; font-weight: 500; line-height: 1.4; }
    .faq-item > summary .faq-icon { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; padding: 0.5rem; border-radius: 50%; background: var(--primary-soft); color: var(--primary-ink); }
    .faq-answer { padding: 0 1.5rem 1.5rem; color: var(--muted); }
    .faq-answer p + p { margin-top: 0.75rem; }

    /* ---------- Llamada final ---------- */
    .cta-panel {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 6vw, 5rem);
      border-radius: clamp(28px, 4vw, 48px);
      background: var(--primary);
      color: var(--on-primary);
      text-align: center;
    }
    .cta-panel .rings {
      z-index: -1;
      left: 50%;
      top: 100%;
      width: max(60rem, 120%);
      background: repeating-radial-gradient(circle at center, transparent 0 calc(3rem - 1px), color-mix(in srgb, var(--on-primary) 22%, transparent) calc(3rem - 1px) 3rem);
    }
    .cta-title { max-width: 22ch; margin-inline: auto; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem); line-height: 1.12; }
    .cta-panel p { max-width: 36rem; margin: 1.25rem auto 0; font-size: 1.125rem; opacity: 0.9; }
    .cta-panel .actions { justify-content: center; margin-top: 2.25rem; }
    .btn-invert { background: var(--on-primary); color: var(--primary); }
    .btn-invert:hover { background: color-mix(in srgb, var(--on-primary) 88%, var(--primary)); }
    .cta-section { padding-block: clamp(2rem, 5vw, 4rem); }

    /* ---------- Contacto ---------- */
    .contact-grid { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); align-items: start; }
    .contact-lines { display: grid; gap: 0.75rem; margin-top: 2rem; }
    .contact-lines a { display: flex; align-items: center; gap: 1rem; padding: 0.875rem 1rem; border-radius: var(--radius); background: var(--surface); font-weight: 600; overflow-wrap: anywhere; transition: background-color 0.2s; }
    .contact-lines a:hover { background: var(--surface-2); }
    .contact-lines .ico { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--card); color: var(--primary-ink); }
    .contact-lines .ico svg { width: 1.25rem; height: 1.25rem; }
    .contact-lines small { display: block; color: var(--muted); font-size: 0.8125rem; font-weight: 600; }
    .place { padding: clamp(1.75rem, 4vw, 2.75rem); border-radius: var(--radius-lg); background: var(--sand); }
    .place h3 { font-family: var(--font-body); font-size: 0.875rem; font-weight: 700; color: var(--primary-ink); }
    .place address { margin-top: 0.5rem; font-family: var(--font-heading); font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.625rem); font-style: normal; line-height: 1.35; }
    .place .link-arrow { margin-top: 1rem; }
    .place-block + .place-block { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent); }
    .hours { margin-top: 0.75rem; }
    .hours li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.125rem 1.5rem; padding: 0.5rem 0; }
    .hours li span:last-child { color: var(--muted); }
    @media (min-width: 900px) { .contact-grid.two { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }

    /* ---------- Pie ---------- */
    .site-footer { padding: clamp(3.5rem, 7vw, 5rem) 0 2rem; background: var(--sand); color: var(--muted); }
    .footer-top { display: grid; gap: 2rem; padding-bottom: 2.5rem; border-bottom: 1px solid color-mix(in srgb, var(--text) 12%, transparent); }
    .footer-brand { display: inline-flex; align-items: center; gap: 0.625rem; color: var(--text); font-family: var(--font-heading); font-size: 1.5rem; font-weight: 500; line-height: 1.2; }
    .footer-brand img { height: 2.75rem; width: auto; }
    .footer-text { max-width: 34rem; margin-top: 0.875rem; font-size: 0.9375rem; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; align-content: start; }
    .footer-links a { color: var(--text); font-weight: 600; }
    .footer-links a:hover { color: var(--primary-ink); }
    .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem; padding-top: 1.75rem; font-size: 0.875rem; }
    @media (min-width: 820px) { .footer-top { grid-template-columns: 1fr auto; } }
  </style>
</head>
<body>
  <a class="skip-link" href="#main"><%= t("skip") %></a>

  <%
    function sectionHead(key, extraClass) {
      const h = heading(key);
      if (!h.eyebrow && !h.title && !h.subtitle) return;
  %>
    <div class="section-head <%= extraClass || '' %>">
      <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
      <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
      <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
    </div>
  <% } %>

  <%
    function colsFor(n, max) {
      if (n <= max) return n;
      if (n % max === 0) return max;
      if (n % (max - 1) === 0) return max - 1;
      return n % max >= n % (max - 1) ? max : max - 1;
    }
    function splitHour(line) {
      const i = line.indexOf(": ");
      return i > 0 ? [line.slice(0, i), line.slice(i + 2)] : ["", line];
    }
    const c = config.contact;
    const hourLines = lines(c.hours);
    const titleSize = (text, m, l) => (text.length > l ? "t-l" : text.length > m ? "t-m" : "");
  %>

  <header class="site-header" data-section="brand">
    <div class="container nav">
      <a class="brand" href="#main">
        <% if (config.brand.logo) { %><%- img(config.brand.logo, config.brand.name, { eager: true, sizes: "160px", width: 480 }) %><% } else { %><span class="brand-mark" aria-hidden="true"></span><% } %>
        <% if (config.brand.name || !config.brand.logo) { %><span><%= config.brand.name %></span><% } %>
      </a>
      <%- navLinks({ limit: 5, exclude: ["contact"] }) %>
      <% if (config.hero.ctaText && show("hero")) { %>
        <a class="btn btn-primary btn-sm nav-cta" <%- linkAttrs(config.hero.ctaLink) %>><%= config.hero.ctaText %></a>
      <% } %>
      <%- mobileMenu({ cta: show("hero") ? { text: config.hero.ctaText, href: config.hero.ctaLink } : undefined }) %>
    </div>
  </header>

  <main id="main">
    <% if (show("hero")) { const hero = config.hero; %>
    <section class="hero" id="hero" data-section="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <% if (hero.eyebrow) { %><p class="eyebrow rise"><%= hero.eyebrow %></p><% } %>
          <% if (hero.title) { %><h1 class="hero-title rise-2 <%= titleSize(hero.title, 60, 100) %>"><%= hero.title %></h1><% } %>
          <% if (hero.subtitle) { %><p class="hero-sub rise-3"><%= hero.subtitle %></p><% } %>
          <% if (hero.ctaText || hero.secondaryCtaText) { %>
          <div class="actions rise-3">
            <% if (hero.ctaText) { %><a class="btn btn-primary btn-lg" <%- linkAttrs(hero.ctaLink) %>><%= hero.ctaText %></a><% } %>
            <% if (hero.secondaryCtaText) { %><a class="btn btn-outline btn-lg" <%- linkAttrs(hero.secondaryCtaLink) %>><%= hero.secondaryCtaText %></a><% } %>
          </div>
          <% } %>
        </div>
        <% if (hero.backgroundImage) { %>
        <div class="hero-figure rise-2">
          <span class="rings" aria-hidden="true"></span>
          <div class="hero-oval"><%- img(hero.backgroundImage, "", { eager: true, sizes: "(min-width: 940px) 27rem, 80vw", width: 1200 }) %></div>
        </div>
        <% } else { %>
        <div class="hero-figure empty" aria-hidden="true"><span class="rings"></span></div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (show("about")) { const a = config.about; const h = heading("about"); %>
    <section class="section" id="about" data-section="about">
      <div class="container about-grid<%= a.image ? ' two' : '' %>">
        <% if (a.image) { %>
        <div class="about-media"><div class="about-frame"><%- img(a.image, a.heading, { sizes: "(min-width: 900px) 30rem, 100vw", width: 1200 }) %></div></div>
        <% } %>
        <div class="about-copy">
          <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
          <% if (a.heading) { %><h2 class="about-title"><%= a.heading %></h2><% } %>
          <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
          <% if (a.content) { %><div class="prose"><%- paras(a.content) %></div><% } %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("features")) { %>
    <section class="section sand" id="features" data-section="features">
      <div class="container">
        <% sectionHead("features") %>
        <ul class="flow c<%= colsFor(config.features.length, 3) %>">
          <% config.features.forEach((f) => { %>
            <li class="spec">
              <span class="spec-icon"><%- icon(f.icon || "leaf") %></span>
              <% if (f.title) { %><h3><%= f.title %></h3><% } %>
              <% if (f.description) { %><p><%= f.description %></p><% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% } %>

    <% if (show("steps")) { const n = config.steps.length; const anyLabel = config.steps.some((s) => s.label); %>
    <section class="section" id="steps" data-section="steps">
      <div class="container">
        <% sectionHead("steps") %>
        <ol class="path<%= n > 1 && n <= 4 ? ' row' : '' %>" style="--n: <%= n %>">
          <% config.steps.forEach((s, i) => { %>
            <li class="path-step<%= anyLabel ? ' label-first' : '' %>">
              <% if (s.label) { %><span class="marker dot" aria-hidden="true"></span><% } else { %><span class="marker" aria-hidden="true"><%= i + 1 %></span><% } %>
              <div class="path-body">
                <% if (s.label) { %><span class="step-label"><%= s.label %></span><% } else { %><span class="sr-only"><%= t("step") %> <%= i + 1 %>:</span><% } %>
                <% if (s.title) { %><h3><%= s.title %></h3><% } %>
                <% if (s.description) { %><p><%= s.description %></p><% } %>
              </div>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>
    <% } %>

    <% if (show("products")) { %>
    <section class="section sand" id="products" data-section="products">
      <div class="container">
        <% sectionHead("products") %>
        <ul class="flow c<%= colsFor(config.products.length, 4) %>">
          <% config.products.forEach((p) => { const perks = lines(p.description); %>
            <li class="plan<%= p.badge ? ' featured' : '' %>">
              <% if (p.image) { %><div class="plan-media"><%- img(p.image, p.title, { sizes: "(min-width: 1100px) 300px, 100vw", width: 800 }) %></div><% } %>
              <% if (p.badge) { %><span class="plan-badge"><%= p.badge %></span><% } %>
              <% if (p.title) { %><h3><%= p.title %></h3><% } %>
              <% if (p.price) { %><p class="plan-price<%= p.price.length > 9 ? ' small' : '' %>"><%= p.price %></p><% } %>
              <% if (perks.length) { %>
              <ul class="checklist"><% perks.forEach((perk) => { %><li><%- icon("check", "") %><%= perk %></li><% }) %></ul>
              <% } %>
              <% if (p.link) { %><div class="plan-end"><a class="btn <%= p.badge ? 'btn-primary' : 'btn-outline' %>" <%- linkAttrs(p.link) %>><%= t("book") %></a></div><% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% } %>

    <% if (show("testimonials")) { %>
    <section class="section reviews" id="testimonials" data-section="testimonials">
      <div class="container">
        <% sectionHead("testimonials") %>
        <div class="flow c<%= colsFor(config.testimonials.length, 3) %>">
          <% config.testimonials.forEach((r) => { %>
            <figure class="voice">
              <%- icon("quote", "quote-icon") %>
              <% if (r.quote) { %><blockquote><%= r.quote %></blockquote><% } %>
              <% if (r.name || r.role) { %>
              <figcaption>
                <span class="avatar"><% if (r.avatar) { %><%- img(r.avatar, r.name, { sizes: "48px", width: 480 }) %><% } else { %><%= initials(r.name) %><% } %></span>
                <div><% if (r.name) { %><strong><%= r.name %></strong><% } %><% if (r.role) { %><span class="role"><%= r.role %></span><% } %></div>
              </figcaption>
              <% } %>
            </figure>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("faqs")) { %>
    <section class="section sand" id="faqs" data-section="faqs">
      <div class="container faq-wrap">
        <% sectionHead("faqs", "center") %>
        <div class="faq-list">
          <% config.faqs.forEach((f, i) => { %>
            <details class="faq-item"<%= i === 0 ? " open" : "" %>>
              <summary><span><%= f.question || t("question") %></span><%- icon("plus", "faq-icon") %></summary>
              <% if (f.answer) { %><div class="faq-answer"><%- paras(f.answer) %></div><% } %>
            </details>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("cta")) { const cta = config.cta; %>
    <section class="cta-section" id="cta" data-section="cta">
      <div class="container">
        <div class="cta-panel">
          <span class="rings" aria-hidden="true"></span>
          <% if (cta.title) { %><h2 class="cta-title"><%= cta.title %></h2><% } %>
          <% if (cta.text) { %><p><%= cta.text %></p><% } %>
          <% if (cta.buttonText) { %>
            <div class="actions"><a class="btn btn-lg btn-invert" <%- linkAttrs(cta.buttonLink) %>><%= cta.buttonText %></a></div>
          <% } %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("contact")) {
         const h = heading("contact");
         const hasLines = c.phone || c.email || c.whatsapp;
         const hasMain = h.eyebrow || h.title || h.subtitle || hasLines;
         const hasPlace = c.address || hourLines.length;
    %>
    <section class="section" id="contact" data-section="contact">
      <div class="container contact-grid<%= hasMain && hasPlace ? ' two' : '' %>">
        <% if (hasMain) { %>
        <div>
          <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
          <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
          <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
          <% if (hasLines) { %>
          <ul class="contact-lines">
            <% if (c.phone) { %><li><a href="<%= telHref(c.phone) %>"><span class="ico"><%- icon("phone", "") %></span><span><small><%= t("phone") %></small><%= c.phone %></span></a></li><% } %>
            <% if (c.whatsapp) { %><li><a <%- linkAttrs(waHref(c.whatsapp)) %>><span class="ico"><%- icon("message-circle", "") %></span><span><small><%= t("whatsapp") %></small><%= c.whatsapp %></span></a></li><% } %>
            <% if (c.email) { %><li><a href="<%= mailHref(c.email) %>"><span class="ico"><%- icon("mail", "") %></span><span><small><%= t("email") %></small><%= c.email %></span></a></li><% } %>
          </ul>
          <% } %>
        </div>
        <% } %>
        <% if (hasPlace) { %>
        <div class="place">
          <% if (c.address) { %>
          <div class="place-block">
            <h3><%= t("practice") %></h3>
            <address><%= c.address %></address>
            <a class="link-arrow" <%- linkAttrs(mapsHref(c.address)) %>><%= t("directions") %><%- icon("arrow-up-right", "") %></a>
          </div>
          <% } %>
          <% if (hourLines.length) { %>
          <div class="place-block">
            <h3><%= t("hours") %></h3>
            <ul class="hours">
              <% hourLines.forEach((line) => { const [day, time] = splitHour(line); %>
                <li><% if (day) { %><span><%= day %></span><% } %><span><%= time %></span></li>
              <% }) %>
            </ul>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>
  </main>

  <% if (show("footer")) { %>
  <footer class="site-footer" id="footer" data-section="footer">
    <div class="container">
      <div class="footer-top">
        <div>
          <p class="footer-brand"><% if (config.brand.logo && !config.brand.name) { %><%- img(config.brand.logo, "", { sizes: "160px", width: 480 }) %><% } else { %><span class="brand-mark" aria-hidden="true"></span><%= config.brand.name %><% } %></p>
          <% if (config.footer.text) { %><p class="footer-text"><%= config.footer.text %></p><% } %>
        </div>
        <% if (config.footer.links.length) { %>
        <nav class="footer-links" aria-label="<%= config.brand.name %>">
          <% config.footer.links.forEach((l) => { %><a <%- linkAttrs(l.url) %>><%= l.label || l.url %></a><% }) %>
        </nav>
        <% } %>
      </div>
      <div class="footer-bottom">
        <p><%- copyright(config.brand.name) %></p>
        <%- madeWith %>
      </div>
    </div>
  </footer>
  <% } %>

  <%- foot %>
</body>
</html>
