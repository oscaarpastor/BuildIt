<!DOCTYPE html>
<html <%- htmlAttrs %>>
<head>
  <%- head %>
  <style>
    /* Agencia: editorial y tipográfica. Papel neutro, tinta casi negra y bermellón;
       serif de alto contraste a tamaño cartel (con cursiva para antetítulos, citas
       y precios) y una sans sobria para leer. Composición asimétrica, filetes de
       tinta y dos bandas fuertes: servicios en tinta y «Hablemos» en el color
       principal. */
    :root {
      --bg: #f5f5f2;
      --surface: #ebeae5;
      --surface-2: #e0dfd9;
      --text: #16181d;
      --muted: #5c5f67;
      --border: #d5d4ce;
      --radius-sm: 2px;
      --radius: 3px;
      --radius-lg: 4px;
      --radius-btn: 999px;
      --header-h: 4.75rem;
      --section-y: clamp(4.5rem, 10vw, 8.5rem);
      /* Tinta: siempre oscura, teñida por el color secundario */
      --ink: color-mix(in srgb, var(--secondary) 22%, #0c0d10);
      --on-ink: #f3f2ee;
      --ink-muted: rgb(243 242 238 / 0.66);
      --ink-line: rgb(243 242 238 / 0.16);
    }
    html.bi-dark {
      --bg: #111215;
      --surface: #18191d;
      --surface-2: #212227;
      --text: #efeee9;
      --muted: #a5a6ac;
      --border: #2d2f35;
      --ink: color-mix(in srgb, var(--secondary) 22%, #08090b);
    }

    body { font-size: 1.0625rem; }
    h1, h2, h3, .title { font-weight: 400; letter-spacing: -0.02em; }
    .title { font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.5rem); line-height: 0.98; }
    .lead { color: var(--muted); }
    .eyebrow {
      margin-bottom: 0.75rem;
      color: var(--primary-ink);
      font-family: var(--font-heading);
      font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.5rem);
      font-style: italic;
      font-weight: 400;
      letter-spacing: 0;
      line-height: 1.2;
      text-transform: none;
    }
    .section-head { margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }

    /* Cabecera de sección partida: título a la izquierda, entradilla abajo a la derecha */
    .head-split { max-width: none; display: grid; gap: 1.25rem 4rem; }
    .head-split .lead { margin-top: 0; max-width: 30rem; }
    @media (min-width: 900px) {
      .head-split { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); align-items: end; }
    }

    .btn { font-weight: 600; letter-spacing: 0.005em; }
    .btn-outline { border-color: var(--text); }
    .btn-outline:hover { background: var(--text); color: var(--bg); }
    .btn-ink { background: var(--text); color: var(--bg); }
    .btn-ink:hover { background: color-mix(in srgb, var(--text) 82%, var(--primary)); }

    /* Cabecera */
    .site-header { background: color-mix(in srgb, var(--bg) 90%, transparent); }
    .site-header .brand { font-size: 1.75rem; font-weight: 400; letter-spacing: -0.015em; }
    .brand-dot {
      flex-shrink: 0;
      width: 0.4rem;
      height: 0.4rem;
      margin: 0.55rem 0 0 -0.55rem;
      align-self: center;
      border-radius: 50%;
      background: var(--primary);
    }
    .nav-links a { color: var(--text); }
    .nav-links a:hover { color: var(--primary-ink); }

    /* Portada tipográfica */
    .hero { padding: clamp(3.5rem, 9vw, 7.5rem) 0 clamp(3.5rem, 7vw, 6rem); }
    .hero-kicker {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
      margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
      color: var(--text);
      font-family: var(--font-heading);
      font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.75rem);
      font-style: italic;
      line-height: 1.25;
    }
    .hero-kicker::before {
      content: "";
      flex-shrink: 0;
      width: 0.55em;
      height: 0.55em;
      border-radius: 50%;
      background: var(--primary);
      transform: translateY(-0.05em);
    }
    .hero-title {
      max-width: 15ch;
      font-size: clamp(3.25rem, 0.9rem + 8.6vw, 9.5rem);
      line-height: 0.9;
      letter-spacing: -0.035em;
    }
    .hero-title.is-mid { max-width: 22ch; font-size: clamp(2.75rem, 1rem + 5.2vw, 6.25rem); line-height: 0.95; }
    .hero-title.is-long { max-width: 30ch; font-size: clamp(2.25rem, 1.2rem + 3.2vw, 4.25rem); line-height: 1.02; letter-spacing: -0.025em; }
    .hero-foot {
      display: grid;
      gap: 2rem 4rem;
      margin-top: clamp(2.5rem, 5vw, 4.5rem);
      padding-top: 1.5rem;
      border-top: 1px solid var(--text);
    }
    .hero-foot:only-child { margin-top: 0; }
    .hero-sub { max-width: 36rem; color: var(--muted); font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem); line-height: 1.5; }
    @media (min-width: 900px) {
      .hero-foot { grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
      .hero-foot .actions { justify-content: flex-end; }
    }
    .hero-media { margin-top: clamp(3rem, 6vw, 5rem); }
    .hero-media .frame { aspect-ratio: 21 / 9; overflow: hidden; border-radius: var(--radius); background: var(--surface); }
    .hero-media .frame > * { width: 100%; height: 100%; object-fit: cover; }
    @media (max-width: 700px) {
      .hero-media .frame { aspect-ratio: 4 / 3; }
      .hero-foot .actions .btn { flex: 1 1 auto; }
    }

    /* Filetes entre celdas que se reorganizan solas (cifras, proceso, contacto) */
    .ruled { overflow: hidden; border-top: 1px solid var(--text); }
    .ruled > .cells {
      display: grid;
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      margin: -1px 0 0 -1px;
    }
    .ruled .cell {
      --pad: clamp(1rem, 2.5vw, 2rem);
      min-width: 0;
      padding-inline: var(--pad);
      border-left: 1px solid var(--border);
      border-top: 1px solid var(--border);
    }
    .cols-1 { --cols: 1; } .cols-2 { --cols: 2; } .cols-3 { --cols: 3; } .cols-4 { --cols: 4; }
    /* La primera columna de cada fila, a ras del filete */
    .ruled.cols-1 .cell, .ruled.cols-2 .cell:nth-child(2n + 1), .ruled.cols-3 .cell:nth-child(3n + 1), .ruled.cols-4 .cell:nth-child(4n + 1) { padding-left: 0; }
    @media (max-width: 900px) {
      .ruled.cols-4, .ruled.cols-3 { --cols: 2; }
      .ruled.cols-3 .cell:nth-child(3n + 1), .ruled.cols-4 .cell:nth-child(4n + 1) { padding-left: var(--pad); }
      .ruled.cols-3 .cell:nth-child(2n + 1), .ruled.cols-4 .cell:nth-child(2n + 1) { padding-left: 0; }
    }
    @media (max-width: 560px) {
      .ruled:not(.keep-2) { --cols: 1; }
      .ruled:not(.keep-2) .cell { padding-inline: 0; }
    }

    /* Cifras */
    .stats .section-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
    .stats .title { font-size: clamp(1.875rem, 1.3rem + 2vw, 3rem); }
    .stat { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.75rem; padding-block: clamp(1.5rem, 3vw, 2.25rem) 0.5rem; }
    .stat dd {
      font-family: var(--font-heading);
      font-size: clamp(3.25rem, 2rem + 3.6vw, 5.5rem);
      line-height: 0.9;
      letter-spacing: -0.03em;
      font-variant-numeric: lining-nums;
      white-space: nowrap;
    }
    /* Cifras largas («12.500+», «1,2 millones»): más pequeñas y, si no caben, en varias líneas */
    .stats .is-wide dd { font-size: clamp(2.5rem, 1.6rem + 2.4vw, 4rem); }
    .stats .is-text dd { font-size: clamp(2rem, 1.5rem + 1.4vw, 2.75rem); line-height: 1.05; white-space: normal; }
    .stat dt { max-width: 16rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.45; }
    @media (max-width: 560px) {
      .stats .ruled dd { font-size: clamp(2.25rem, 1.2rem + 6vw, 3.25rem); }
      .stats .is-text dd { font-size: 1.75rem; }
    }

    /* Servicios: lista numerada en la banda de tinta */
    .services { background: var(--ink); color: var(--on-ink); }
    html.bi-dark .services { border-block: 1px solid var(--border); }
    .services .eyebrow { color: var(--primary-on-dark); }
    .services .lead { color: var(--ink-muted); }
    .svc-list { border-bottom: 1px solid var(--ink-line); }
    .svc {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 24rem);
      gap: 0.75rem 2.5rem;
      align-items: baseline;
      padding: clamp(1.5rem, 3vw, 2.25rem) 0;
      border-top: 1px solid var(--ink-line);
    }
    .svc-num { color: var(--primary-on-dark); font-family: var(--font-heading); font-size: 1.5rem; font-style: italic; line-height: 1; font-variant-numeric: lining-nums; }
    .svc h3 {
      font-size: clamp(2rem, 1.2rem + 2.8vw, 3.75rem);
      line-height: 1;
      letter-spacing: -0.025em;
      transition: transform 0.4s var(--ease), color 0.3s;
    }
    .svc:hover h3 { color: var(--primary-on-dark); transform: translateX(0.5rem); }
    .svc p { color: var(--ink-muted); font-size: 1rem; line-height: 1.6; }
    @media (max-width: 860px) {
      .svc { grid-template-columns: 2.75rem minmax(0, 1fr); }
      .svc p { grid-column: 2; }
      .svc-num { font-size: 1.25rem; }
    }

    /* Proceso */
    .proc .cell { padding-block: clamp(1.5rem, 3vw, 2.25rem) 0.25rem; }
    .proc-num { display: block; color: var(--primary-ink); font-family: var(--font-heading); font-size: clamp(3rem, 2rem + 3vw, 4.5rem); font-style: italic; line-height: 0.8; }
    .proc-label { display: block; margin-top: 1rem; color: var(--muted); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.01em; }
    .proc h3 { margin-top: 1.25rem; font-size: clamp(1.625rem, 1.3rem + 0.9vw, 2.125rem); line-height: 1.05; }
    .proc-label + h3 { margin-top: 0.5rem; }
    .proc p { max-width: 34rem; margin-top: 0.75rem; color: var(--muted); font-size: 1rem; }
    @media (max-width: 560px) { .proc .cell { padding-bottom: 1.5rem; } }

    /* Paquetes */
    .packages { background: var(--surface); }
    .pkgs { --per: 3; display: flex; flex-wrap: wrap; justify-content: center; gap: 1.25rem; }
    .pkgs.per-2 { --per: 2; }
    .pkg {
      display: flex;
      flex-direction: column;
      flex: 0 1 calc((100% - (var(--per) - 1) * 1.25rem) / var(--per));
      min-width: 0;
      padding: clamp(1.75rem, 3vw, 2.5rem);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg);
    }
    .pkgs.per-2 .pkg { max-width: 34rem; }
    .pkg-media { aspect-ratio: 3 / 2; margin: calc(clamp(1.75rem, 3vw, 2.5rem) * -1) calc(clamp(1.75rem, 3vw, 2.5rem) * -1) 1.75rem; overflow: hidden; }
    .pkg-media > * { width: 100%; height: 100%; object-fit: cover; }
    .pkg-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; }
    .pkg h3 { font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); line-height: 1.05; }
    .pkg-badge {
      padding: 0.25rem 0.75rem;
      border: 1px solid currentColor;
      border-radius: 999px;
      color: var(--primary-ink);
      font-size: 0.8125rem;
      font-weight: 600;
      line-height: 1.35;
    }
    .pkg-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.5rem; margin-top: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
    .pkg-from { font-family: var(--font-heading); font-size: 1.375rem; font-style: italic; color: var(--muted); }
    .pkg-amount { font-family: var(--font-heading); font-size: clamp(2.5rem, 2rem + 1.6vw, 3.375rem); line-height: 1; letter-spacing: -0.02em; }
    .pkg-per { color: var(--muted); font-size: 1rem; }
    .pkg.is-featured .pkg-per { color: var(--ink-muted); }
    .pkg-amount.is-long { font-size: clamp(2rem, 1.7rem + 0.9vw, 2.5rem); }
    .pkg-list { flex: 1; margin-top: 1.5rem; font-size: 1rem; line-height: 1.5; }
    .pkg-desc { flex: 1; margin-top: 1.5rem; color: var(--muted); font-size: 1rem; }
    .pkg-top + .pkg-list, .pkg-top + .pkg-desc { margin-top: 1.25rem; }
    .pkg .btn { width: 100%; margin-top: 2rem; }
    .pkg.is-featured { border-color: transparent; background: var(--ink); color: var(--on-ink); }
    html.bi-dark .pkg.is-featured { border-color: color-mix(in srgb, var(--primary) 55%, transparent); }
    .pkg.is-featured .pkg-badge { border-color: transparent; background: var(--primary); color: var(--on-primary); }
    .pkg.is-featured .pkg-from, .pkg.is-featured .pkg-desc { color: var(--ink-muted); }
    .pkg.is-featured .pkg-price { border-color: var(--ink-line); }
    .pkg.is-featured .checklist li svg { color: var(--primary-on-dark); }
    @media (max-width: 960px) { .pkgs, .pkgs.per-2 { --per: 2; } }
    @media (max-width: 640px) {
      .pkgs, .pkgs.per-2 { --per: 1; }
      .pkgs .pkg { max-width: none; }
    }

    /* Estudio */
    .about-grid { display: grid; gap: clamp(2.5rem, 6vw, 5.5rem); align-items: end; }
    .about-media .frame { aspect-ratio: 5 / 4; overflow: hidden; border-radius: var(--radius); background: var(--surface); }
    .about-media .frame > * { width: 100%; height: 100%; object-fit: cover; }
    .about-title { font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4.5rem); line-height: 0.98; }
    .about-copy .lead { margin-top: 1.25rem; }
    .about-copy .prose { margin-top: 1.75rem; color: var(--muted); }
    .about-grid.text-only .about-copy .prose { margin-top: 0; }
    @media (min-width: 900px) {
      .about-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
      .about-grid.text-only { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: start; }
      .about-grid.text-only .prose { padding-top: 1.5rem; border-top: 1px solid var(--text); font-size: 1.125rem; }
    }

    /* Clientes: citas en fila, autor a la izquierda */
    .voices { background: var(--surface); }
    .quotes { border-top: 1px solid var(--text); }
    .q {
      display: grid;
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      gap: 1.5rem clamp(2rem, 5vw, 5rem);
      padding: clamp(2rem, 4vw, 3rem) 0;
      border-bottom: 1px solid var(--border);
    }
    .q:last-child { border-bottom: 0; padding-bottom: 0; }
    .q blockquote {
      grid-column: 2;
      grid-row: 1;
      max-width: 46rem;
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.375rem);
      font-style: italic;
      line-height: 1.18;
      letter-spacing: -0.01em;
      text-wrap: pretty;
    }
    .q-who { grid-column: 1; grid-row: 1; display: flex; align-items: center; gap: 0.875rem; align-self: start; padding-top: 0.375rem; }
    .q-who .avatar { width: 3.25rem; height: 3.25rem; background: var(--bg); color: var(--primary-ink); font-family: var(--font-heading); font-size: 1.25rem; font-weight: 400; }
    .q-who strong { display: block; font-size: 0.9375rem; font-weight: 600; line-height: 1.3; }
    .q-who span:not(.avatar) { display: block; color: var(--muted); font-size: 0.875rem; line-height: 1.4; }
    @media (max-width: 760px) {
      .q { grid-template-columns: minmax(0, 1fr); }
      .q blockquote, .q-who { grid-column: 1; grid-row: auto; }
    }

    /* Preguntas */
    .faq-wrap { display: grid; gap: 1rem 4rem; }
    @media (min-width: 960px) {
      .faq-wrap { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
      .faq-wrap .section-head { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
    }
    .faq-list { border-top: 1px solid var(--text); }
    .faq-item { border-bottom: 1px solid var(--border); }
    .faq-item > summary {
      padding: 1.5rem 0;
      font-family: var(--font-heading);
      font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.875rem);
      line-height: 1.15;
    }
    .faq-item > summary:hover { color: var(--primary-ink); }
    .faq-item > summary .faq-icon {
      width: 2.25rem;
      height: 2.25rem;
      padding: 0.5rem;
      border: 1px solid var(--border);
      border-radius: 50%;
      color: var(--text);
    }
    .faq-item[open] > summary .faq-icon { border-color: var(--primary); background: var(--primary); color: var(--on-primary); }
    .faq-answer { max-width: 42rem; padding: 0 3.5rem 1.75rem 0; color: var(--muted); }

    /* Hablemos */
    .cta-band { background: var(--primary); color: var(--on-primary); }
    .cta-title {
      font-size: clamp(4.5rem, 1rem + 15vw, 15rem);
      line-height: 0.85;
      letter-spacing: -0.045em;
    }
    .cta-title.is-mid { font-size: clamp(3rem, 1.2rem + 5.6vw, 6.75rem); line-height: 0.92; letter-spacing: -0.03em; }
    .cta-title.is-long { font-size: clamp(2.25rem, 1.3rem + 3vw, 4.25rem); line-height: 1; letter-spacing: -0.02em; }
    .cta-foot {
      display: grid;
      gap: 1.75rem 4rem;
      margin-top: clamp(2rem, 4vw, 3.5rem);
      padding-top: 1.5rem;
      border-top: 1px solid color-mix(in srgb, var(--on-primary) 40%, transparent);
    }
    .cta-foot:only-child { margin-top: 0; }
    .cta-foot p { max-width: 36rem; font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3125rem); line-height: 1.5; opacity: 0.9; }
    @media (min-width: 900px) {
      .cta-foot { grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
    }
    .cta-band .btn-dark {
      background: var(--ink);
      color: #fff;
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-primary) 30%, transparent);
    }
    .cta-band .btn-dark:hover { background: color-mix(in srgb, var(--ink) 85%, #fff); }

    /* Contacto */
    .big-line {
      display: inline-block;
      max-width: 100%;
      margin-bottom: clamp(2.5rem, 5vw, 4rem);
      font-family: var(--font-heading);
      font-size: clamp(2rem, 0.8rem + 5vw, 5.5rem);
      line-height: 1.02;
      letter-spacing: -0.025em;
      text-decoration: underline;
      text-decoration-color: var(--primary);
      text-decoration-thickness: 0.06em;
      text-underline-offset: 0.12em;
      overflow-wrap: anywhere;
      transition: color 0.2s;
    }
    .big-line:hover { color: var(--primary-ink); }
    .reach .cell { padding-block: 1.5rem 0.5rem; }
    .reach-label { display: block; margin-bottom: 0.5rem; color: var(--primary-ink); font-family: var(--font-heading); font-size: 1.375rem; font-style: italic; line-height: 1.2; }
    .reach-value { display: block; overflow-wrap: anywhere; }
    .reach-value span { display: block; }
    a.reach-value { font-weight: 600; text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 4px; }
    a.reach-value:hover { text-decoration-color: currentColor; }
    .reach .link-arrow { margin-top: 0.75rem; color: var(--text); font-size: 0.9375rem; }

    /* Pie */
    .site-footer { padding: clamp(4rem, 8vw, 6rem) 0 2rem; background: var(--ink); color: var(--ink-muted); }
    html.bi-dark .site-footer { border-top: 1px solid var(--border); }
    .footer-top { display: grid; gap: 2rem; }
    @media (min-width: 820px) { .footer-top { grid-template-columns: minmax(0, 1fr) auto; align-items: start; } }
    .footer-text { max-width: 28rem; font-size: 1rem; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 0.625rem 1.75rem; max-width: 36rem; }
    .footer-links a { color: var(--on-ink); font-weight: 500; }
    .footer-links a:hover { color: var(--primary-on-dark); }
    .footer-word {
      margin-top: clamp(3rem, 7vw, 6rem);
      color: var(--on-ink);
      font-family: var(--font-heading);
      font-size: clamp(3.5rem, 0.5rem + 12.5vw, 13rem);
      line-height: 0.88;
      letter-spacing: -0.04em;
      overflow-wrap: anywhere;
    }
    .footer-word.is-long { font-size: clamp(2.75rem, 0.8rem + 6.5vw, 7rem); line-height: 0.95; }
    .footer-word img { width: auto; height: clamp(3rem, 8vw, 6rem); max-width: 100%; object-fit: contain; }
    .footer-bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.75rem 2rem;
      margin-top: clamp(2rem, 4vw, 3rem);
      padding-top: 1.5rem;
      border-top: 1px solid var(--ink-line);
      font-size: 0.875rem;
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main"><%= t("skip") %></a>

  <%
    // Cabecera de sección: "split" (título a la izquierda, entradilla a la derecha) o normal
    function sectionHead(key, variant) {
      const h = heading(key);
      if (!h.eyebrow && !h.title && !h.subtitle) return;
      if (variant === "split") {
  %>
    <div class="section-head head-split">
      <% if (h.eyebrow || h.title) { %>
      <div>
        <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
        <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
      </div>
      <% } %>
      <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
    </div>
  <%  } else { %>
    <div class="section-head">
      <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
      <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
      <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
    </div>
  <%  }
    }

    // Columnas para listas cortas sin huérfanos raros: 5 y 6 en tres, 7 y 8 en cuatro
    const colsFor = (n) => (n <= 4 ? n : n % 3 === 0 || n === 5 ? 3 : 4);
    const hero = config.hero;
    const c = config.contact;
    const brandName = config.brand.name;
    // Botón «Hablemos» de la cabecera: lleva al contacto (o a la llamada final)
    const talkHref = show("contact") ? "#contact" : show("cta") ? "#cta" : "";
    const talkText = sectionName("cta");
  %>

  <header class="site-header" data-section="brand">
    <div class="container nav">
      <a class="brand" href="#main">
        <% if (config.brand.logo) { %><%- img(config.brand.logo, brandName, { eager: true, sizes: "160px", width: 480 }) %><% } %>
        <% if (brandName || !config.brand.logo) { %><span><%= brandName %></span><% if (!config.brand.logo) { %><i class="brand-dot" aria-hidden="true"></i><% } %><% } %>
      </a>
      <%- navLinks({ limit: 5, exclude: ["contact"] }) %>
      <% if (talkHref) { %><a class="btn btn-ink btn-sm nav-cta" href="<%= talkHref %>"><%= talkText %></a><% } %>
      <%- mobileMenu({ cta: talkHref ? { text: talkText, href: talkHref, class: "btn-ink" } : undefined }) %>
    </div>
  </header>

  <main id="main">
    <% if (show("hero")) {
         const len = hero.title.length;
         const size = len > 90 ? " is-long" : len > 45 ? " is-mid" : "";
    %>
    <section class="hero" id="hero" data-section="hero">
      <div class="container">
        <% if (hero.eyebrow) { %><p class="hero-kicker rise"><%= hero.eyebrow %></p><% } %>
        <% if (hero.title) { %><h1 class="hero-title rise-2<%= size %>"><%= hero.title %></h1><% } %>
        <% if (hero.subtitle || hero.ctaText || hero.secondaryCtaText) { %>
        <div class="hero-foot rise-3">
          <% if (hero.subtitle) { %><p class="hero-sub"><%= hero.subtitle %></p><% } else { %><span></span><% } %>
          <% if (hero.ctaText || hero.secondaryCtaText) { %>
          <div class="actions">
            <% if (hero.ctaText) { %><a class="btn btn-primary btn-lg" <%- linkAttrs(hero.ctaLink) %>><%= hero.ctaText %></a><% } %>
            <% if (hero.secondaryCtaText) { %><a class="btn btn-outline btn-lg" <%- linkAttrs(hero.secondaryCtaLink) %>><%= hero.secondaryCtaText %></a><% } %>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
      <% if (hero.backgroundImage) { %>
        <div class="container hero-media rise-3">
          <div class="frame"><%- img(hero.backgroundImage, "", { eager: true, sizes: "(min-width: 1200px) 1120px, 100vw", width: 2000 }) %></div>
        </div>
      <% } %>
    </section>
    <% } %>

    <% if (show("stats")) {
         const st = config.stats;
         const longest = Math.max(...st.map((s) => s.value.length));
         const valueSize = longest > 9 ? " is-text" : longest > 7 ? " is-wide" : "";
    %>
    <section class="section stats" id="stats" data-section="stats">
      <div class="container">
        <% sectionHead("stats") %>
        <div class="ruled keep-2 cols-<%= colsFor(st.length) %><%= valueSize %>">
          <dl class="cells">
            <% st.forEach((s) => { %>
              <div class="cell stat">
                <dt><%= s.label %></dt>
                <dd><%= s.value %></dd>
              </div>
            <% }) %>
          </dl>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("features")) { %>
    <section class="section services" id="features" data-section="features">
      <div class="container">
        <% sectionHead("features", "split") %>
        <ol class="svc-list">
          <% config.features.forEach((f, i) => { %>
            <li class="svc">
              <span class="svc-num" aria-hidden="true"><%= String(i + 1).padStart(2, "0") %></span>
              <% if (f.title) { %><h3><%= f.title %></h3><% } else { %><span></span><% } %>
              <% if (f.description) { %><p><%= f.description %></p><% } %>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>
    <% } %>

    <% if (show("steps")) { const ss = config.steps; %>
    <section class="section" id="steps" data-section="steps">
      <div class="container">
        <% sectionHead("steps", "split") %>
        <div class="ruled proc cols-<%= colsFor(ss.length) %>">
          <ol class="cells">
            <% ss.forEach((s, i) => { %>
              <li class="cell">
                <span class="proc-num" aria-hidden="true"><%= i + 1 %></span>
                <% if (s.label) { %><span class="proc-label"><%= s.label %></span><% } %>
                <% if (s.title) { %><h3><%= s.title %></h3><% } %>
                <% if (s.description) { %><p><%= s.description %></p><% } %>
              </li>
            <% }) %>
          </ol>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("products")) {
         const ps = config.products;
         const featuredIdx = ps.findIndex((p) => p.badge);
         const withMedia = ps.some((p) => p.image);
    %>
    <section class="section packages" id="products" data-section="products">
      <div class="container">
        <% sectionHead("products", "split") %>
        <ul class="pkgs<%= ps.length === 2 || ps.length === 4 ? ' per-2' : '' %>">
          <% ps.forEach((p, i) => {
               const featured = i === featuredIdx;
               const items = lines(p.description);
               // «desde 3.500 €» → «desde» en cursiva y la cifra grande
               const m = p.price.match(/^(desde|a partir de|from|starting at)\s+(.+)$/i);
               const from = m ? m[1] : "";
               const rest = m ? m[2] : p.price;
               const cut = rest.indexOf("/");
               const amount = (cut > 0 ? rest.slice(0, cut).trim() : rest).replace(/\s+(€|\$|£)/g, "\u00a0$1");
               const per = cut > 0 ? rest.slice(cut).trim() : "";
          %>
            <li class="pkg<%= featured ? ' is-featured' : '' %>">
              <% if (withMedia) { %><div class="pkg-media"><%- img(p.image, p.title, { sizes: "(min-width: 900px) 380px, 100vw", width: 800 }) %></div><% } %>
              <% if (p.title || p.badge) { %>
              <div class="pkg-top">
                <% if (p.title) { %><h3><%= p.title %></h3><% } %>
                <% if (p.badge) { %><span class="pkg-badge"><%= p.badge %></span><% } %>
              </div>
              <% } %>
              <% if (p.price) { %>
                <p class="pkg-price"><% if (from) { %><span class="pkg-from"><%= from %></span><% } %><span class="pkg-amount<%= amount.length > 8 ? ' is-long' : '' %>"><%= amount %></span><% if (per) { %><span class="pkg-per"><%= per %></span><% } %></p>
              <% } %>
              <% if (items.length > 1) { %>
                <ul class="checklist pkg-list"><% items.forEach((item) => { %><li><%- icon("check", "") %><%= item %></li><% }) %></ul>
              <% } else if (items.length) { %>
                <p class="pkg-desc"><%= items[0] %></p>
              <% } %>
              <% if (p.link) { %>
                <a class="btn <%= featured ? 'btn-primary' : 'btn-outline' %>" <%- linkAttrs(p.link) %>><%= t("packageCta") %></a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% } %>

    <% if (show("about")) { const a = config.about; const h = heading("about"); %>
    <section class="section" id="about" data-section="about">
      <div class="container about-grid<%= a.image ? '' : ' text-only' %>">
        <% if (a.image) { %>
          <figure class="about-media"><div class="frame"><%- img(a.image, a.heading || brandName, { sizes: "(min-width: 900px) 640px, 100vw", width: 1600 }) %></div></figure>
        <% } %>
        <div class="about-copy">
          <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
          <% if (a.heading) { %><h2 class="about-title"><%= a.heading %></h2><% } %>
          <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
          <% if (a.content && a.image) { %><div class="prose"><%- paras(a.content) %></div><% } %>
        </div>
        <% if (a.content && !a.image) { %><div class="about-copy"><div class="prose"><%- paras(a.content) %></div></div><% } %>
      </div>
    </section>
    <% } %>

    <% if (show("testimonials")) { %>
    <section class="section voices" id="testimonials" data-section="testimonials">
      <div class="container">
        <% sectionHead("testimonials", "split") %>
        <ul class="quotes">
          <% config.testimonials.forEach((r) => { %>
            <li>
              <figure class="q">
                <% if (r.quote) { %><blockquote>“<%= r.quote %>”</blockquote><% } %>
                <% if (r.name || r.role || r.avatar) { %>
                <figcaption class="q-who">
                  <span class="avatar"><% if (r.avatar) { %><%- img(r.avatar, r.name, { sizes: "56px", width: 480 }) %><% } else { %><%= initials(r.name) %><% } %></span>
                  <span><% if (r.name) { %><strong><%= r.name %></strong><% } %><% if (r.role) { %><span><%= r.role %></span><% } %></span>
                </figcaption>
                <% } %>
              </figure>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% } %>

    <% if (show("faqs")) { %>
    <section class="section" id="faqs" data-section="faqs">
      <div class="container faq-wrap">
        <div><% sectionHead("faqs") %></div>
        <div class="faq-list">
          <% config.faqs.forEach((f, i) => { %>
            <details class="faq-item"<%= i === 0 ? " open" : "" %>>
              <summary><span><%= f.question || t("question") %></span><%- icon("plus", "faq-icon") %></summary>
              <% if (f.answer) { %><div class="faq-answer"><%- paras(f.answer) %></div><% } %>
            </details>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("cta")) {
         const cta = config.cta;
         const tl = cta.title.length;
         const size = tl > 40 ? " is-long" : tl > 14 ? " is-mid" : "";
    %>
    <section class="section cta-band" id="cta" data-section="cta">
      <div class="container">
        <% if (cta.title) { %><h2 class="cta-title<%= size %>"><%= cta.title %></h2><% } %>
        <% if (cta.text || cta.buttonText) { %>
        <div class="cta-foot">
          <% if (cta.text) { %><p><%= cta.text %></p><% } else { %><span></span><% } %>
          <% if (cta.buttonText) { %><div class="actions"><a class="btn btn-lg btn-dark" <%- linkAttrs(cta.buttonLink) %>><%= cta.buttonText %></a></div><% } %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (show("contact")) {
         const hourLines = lines(c.hours);
         // La línea grande es el email (o el teléfono si no hay email)
         const big = c.email ? { text: c.email, href: mailHref(c.email) } : c.phone ? { text: c.phone, href: telHref(c.phone) } : null;
         const blocks = [];
         if (c.phone && c.email) blocks.push("phone");
         if (c.whatsapp) blocks.push("whatsapp");
         if (c.address) blocks.push("address");
         if (hourLines.length) blocks.push("hours");
    %>
    <section class="section reach" id="contact" data-section="contact">
      <div class="container">
        <% sectionHead("contact") %>
        <% if (big) { %><a class="big-line" href="<%= big.href || '#' %>"><%= big.text %></a><% } %>
        <% if (blocks.length) { %>
        <div class="ruled cols-<%= colsFor(blocks.length) %>">
          <div class="cells">
            <% blocks.forEach((b) => { %>
              <div class="cell">
                <% if (b === "phone") { %>
                  <span class="reach-label"><%= t("phone") %></span>
                  <a class="reach-value" href="<%= telHref(c.phone) %>"><%= c.phone %></a>
                <% } else if (b === "whatsapp") { %>
                  <span class="reach-label"><%= t("whatsapp") %></span>
                  <a class="reach-value" <%- linkAttrs(waHref(c.whatsapp)) %>><%= c.whatsapp %></a>
                <% } else if (b === "address") { %>
                  <span class="reach-label"><%= t("address") %></span>
                  <span class="reach-value"><%= c.address %></span>
                  <a class="link-arrow" <%- linkAttrs(mapsHref(c.address)) %>><%= t("directions") %><%- icon("arrow-up-right", "") %></a>
                <% } else { %>
                  <span class="reach-label"><%= t("hours") %></span>
                  <span class="reach-value"><% hourLines.forEach((line) => { %><span><%= line %></span><% }) %></span>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>
  </main>

  <% if (show("footer")) { %>
  <footer class="site-footer" id="footer" data-section="footer">
    <div class="container">
      <% if (config.footer.text || config.footer.links.length) { %>
      <div class="footer-top">
        <% if (config.footer.text) { %><p class="footer-text"><%= config.footer.text %></p><% } else { %><span></span><% } %>
        <% if (config.footer.links.length) { %>
        <nav class="footer-links" aria-label="<%= brandName || t('menu') %>">
          <% config.footer.links.forEach((l) => { %><a <%- linkAttrs(l.url) %>><%= l.label || l.url %></a><% }) %>
        </nav>
        <% } %>
      </div>
      <% } %>
      <% if (brandName || config.brand.logo) { %>
      <p class="footer-word<%= brandName.length > 18 ? ' is-long' : '' %>"><% if (config.brand.logo && !brandName) { %><%- img(config.brand.logo, "", { sizes: "320px", width: 800 }) %><% } else { %><%= brandName %><% } %></p>
      <% } %>
      <div class="footer-bottom">
        <p><%- copyright(brandName) %></p>
        <%- madeWith %>
      </div>
    </div>
  </footer>
  <% } %>

  <%- foot %>
</body>
</html>
