<!DOCTYPE html>
<html <%- htmlAttrs %>>
<head>
  <%- head %>
  <style>
    /* Casa rural: natural, cálida y sin prisa. Musgo (principal) y teja
       (secundario) sobre un fondo de cal verdosa; titulares Young Serif. El
       arco de una puerta de piedra se repite (portada, la casa, habitaciones)
       y la banda de reserva remata con un alero de tejas. */
    :root {
      --bg: #f1f2ea;
      --surface: #e6e8dc;
      --surface-2: #d9dccd;
      --text: #252a1f;
      --muted: #5c6352;
      --border: #d3d6c6;
      --radius-sm: 8px;
      --radius: 14px;
      --radius-lg: 22px;
      --radius-btn: 999px;
      --header-h: 4.75rem;
      /* Musgo muy oscuro fijo aunque el principal sea claro */
      --deep: color-mix(in srgb, var(--primary) 45%, #0e110b);
      --deepest: color-mix(in srgb, var(--primary) 30%, #080a06);
      --on-deep: #f1f2ea;
      --on-deep-muted: rgb(241 242 234 / 0.74);
      --line-deep: rgb(241 242 234 / 0.16);
      --arch: 999px 999px var(--radius) var(--radius);
      --strip-gap: clamp(1rem, 2vw, 1.5rem);
    }
    html.bi-dark {
      --bg: #141712;
      --surface: #1b1f18;
      --surface-2: #252a21;
      --text: #eef0e7;
      --muted: #aab19f;
      --border: #30362b;
      --deep: color-mix(in srgb, var(--primary) 32%, #0b0d09);
      --deepest: color-mix(in srgb, var(--primary) 20%, #050604);
    }

    h1, h2, h3 { font-weight: 400; letter-spacing: -0.01em; }
    .title { font-size: clamp(2rem, 1.35rem + 2.6vw, 3.25rem); font-weight: 400; line-height: 1.08; letter-spacing: -0.015em; }
    .eyebrow {
      margin-bottom: 0.875rem;
      color: var(--secondary-ink);
      font-size: 1.0625rem;
      font-style: italic;
      font-weight: 500;
      letter-spacing: 0;
      text-transform: none;
    }
    .lead { line-height: 1.6; }

    /* Cabecera: transparente sobre la portada, normal si no hay portada */
    .brand { font-weight: 400; font-size: 1.375rem; }
    .site-header:not(.solid) {
      position: absolute;
      inset: 0 0 auto;
      background: transparent;
      border: 0;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      color: #fff;
    }
    .site-header:not(.solid) .nav-links a { color: rgb(255 255 255 / 0.86); }
    .site-header:not(.solid) .nav-links a:hover { color: #fff; }
    .site-header:not(.solid) .nav-cta { background: rgb(255 255 255 / 0.94); color: #252a1f; }
    .site-header:not(.solid) .nav-cta:hover { background: #fff; }
    .menu-panel { color: var(--text); }

    /* Portada: paisaje a sangre y un arco de puerta que se abre a la página */
    .hero {
      position: relative;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
      min-height: min(100svh, 940px);
      padding-top: calc(var(--header-h) + clamp(4rem, 12vh, 8rem));
      overflow: hidden;
      background:
        radial-gradient(70% 60% at 85% 15%, color-mix(in srgb, var(--secondary) 30%, transparent), transparent 70%),
        radial-gradient(60% 50% at 10% 90%, color-mix(in srgb, var(--primary) 50%, transparent), transparent 70%),
        var(--deep);
    }
    .hero-media { position: absolute; inset: 0; z-index: -2; }
    .hero-media img { width: 100%; height: 100%; object-fit: cover; }
    .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to bottom, rgb(14 17 11 / 0.55), transparent 32%); }
    .hero-arch {
      width: min(100%, 37rem);
      padding: clamp(4.5rem, 11vw, 6.75rem) clamp(1.5rem, 4.5vw, 3.25rem) clamp(2.25rem, 4.5vw, 3.25rem);
      border-radius: 999px 999px 0 0;
      background: var(--bg);
      text-align: center;
    }
    .hero-arch .eyebrow { display: inline-flex; flex-direction: column; align-items: center; gap: 0.625rem; margin-bottom: 1.25rem; }
    .hero-arch .eyebrow svg { width: 1.625rem; height: 1.625rem; }
    .hero-title { font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.75rem); line-height: 1.04; letter-spacing: -0.02em; }
    .hero-title.is-long { font-size: clamp(1.625rem, 1.3rem + 1.1vw, 2.25rem); line-height: 1.15; }
    .hero-sub { max-width: 30rem; margin: 1.25rem auto 0; color: var(--muted); font-size: clamp(1.0625rem, 1rem + 0.2vw, 1.1875rem); }
    .hero-arch .actions { justify-content: center; margin-top: 2rem; }

    /* La casa */
    .about-grid { display: grid; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
    .about-media { aspect-ratio: 4 / 5; max-width: 30rem; overflow: hidden; border-radius: var(--arch); background: var(--surface-2); }
    .about-media > img, .about-media > .ph { width: 100%; height: 100%; object-fit: cover; }
    .about-title { font-size: clamp(2rem, 1.35rem + 2.6vw, 3.25rem); line-height: 1.08; letter-spacing: -0.015em; }
    .about .prose { margin-top: 1.5rem; color: var(--muted); font-size: 1.125rem; line-height: 1.7; }
    @media (min-width: 900px) { .about-grid.has-media { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); } }
    .about-grid:not(.has-media) .about-copy { max-width: 44rem; }

    /* Comodidades: banda musgo */
    .amenities { background: var(--deep); color: var(--on-deep); }
    .amenities .eyebrow { color: var(--secondary-on-dark); }
    .amenities .lead { color: var(--on-deep-muted); }
    .amenity-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr)); gap: 2.5rem 2rem; }
    .amenity { min-width: 0; }
    .amenity-icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; margin-bottom: 1.125rem; border-radius: 50%; background: color-mix(in srgb, var(--secondary) 26%, transparent); color: color-mix(in srgb, var(--secondary-on-dark) 70%, #fff); }
    .amenity-icon svg { width: 1.375rem; height: 1.375rem; }
    .amenity h3 { font-size: 1.25rem; line-height: 1.25; }
    .amenity p { margin-top: 0.5rem; color: var(--on-deep-muted); font-size: 0.9875rem; line-height: 1.55; }
    @media (max-width: 520px) {
      .amenity-grid { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
      .amenity { display: grid; grid-template-columns: 3.25rem minmax(0, 1fr); gap: 0 1rem; }
      .amenity-icon { grid-row: span 2; margin-bottom: 0; }
    }

    /* Habitaciones: tarjetas con arco, centradas si la última fila no se llena */
    .rooms-grid { --gap: clamp(1.25rem, 3vw, 2.5rem); display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(2.75rem, 5vw, 3.5rem) var(--gap); }
    .room { display: flex; flex-direction: column; flex: 0 1 calc((100% - 2 * var(--gap)) / 3); min-width: 0; }
    .room-media { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--arch); background: var(--surface-2); }
    .room-media > img, .room-media > .ph { width: 100%; height: 100%; object-fit: cover; }
    .room-badge {
      position: absolute;
      left: 50%;
      bottom: 1rem;
      max-width: calc(100% - 2rem);
      padding: 0.375rem 0.875rem;
      border-radius: 999px;
      background: var(--secondary);
      color: var(--on-secondary);
      font-size: 0.8125rem;
      font-weight: 700;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transform: translateX(-50%);
    }
    .room-body { display: flex; flex-direction: column; flex: 1; padding-top: 1.375rem; text-align: center; }
    .room h3 { font-size: clamp(1.5rem, 1.35rem + 0.4vw, 1.75rem); line-height: 1.15; }
    .room-cap { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 0.625rem; font-weight: 600; font-size: 0.9375rem; }
    .room-cap svg { width: 1.125rem; height: 1.125rem; color: var(--primary-ink); flex-shrink: 0; }
    .room-note { margin-top: 0.25rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.5; }
    .room-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem 1.25rem; margin-top: auto; padding-top: 1.25rem; }
    .room-price { font-family: var(--font-heading); font-size: 1.1875rem; line-height: 1.2; color: var(--primary-ink); }
    .rooms-grid.no-media .room { padding: 2.25rem 1.75rem; border-radius: var(--arch); background: var(--surface); }
    .rooms-grid.no-media .room-body { padding-top: 2rem; }
    .rooms-grid.no-media .room-badge { position: static; align-self: center; margin-bottom: 1rem; transform: none; }
    @media (max-width: 1023.98px) { .room { flex-basis: calc((100% - var(--gap)) / 2); } }
    @media (max-width: 599.98px) { .room { flex-basis: 100%; } .room-media { aspect-ratio: 4 / 5; } }
    @media (min-width: 600px) { .rooms-grid.count-1 .room { flex-basis: min(100%, 26rem); } }
    /* Cuatro u ocho habitaciones: en una fila de cuatro, sin una suelta abajo */
    @media (min-width: 1100px) { .rooms-grid.count-4 .room, .rooms-grid.count-8 .room { flex-basis: calc((100% - 3 * var(--gap)) / 4); } }

    /* Fotos: tira horizontal, como hojear postales */
    .gallery .section-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
    .strip {
      display: flex;
      gap: var(--strip-gap);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      padding: 0 max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter))) 1.25rem;
      scroll-padding-inline: max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter)));
      scrollbar-width: thin;
      scrollbar-color: color-mix(in srgb, var(--primary-ink) 60%, transparent) transparent;
    }
    .strip:focus-visible { outline-offset: -2px; }
    .frame { flex: 0 0 auto; width: min-content; scroll-snap-align: start; }
    .pic { height: clamp(15rem, 32vw, 26rem); aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface-2); }
    .frame:nth-child(3n + 2) .pic { aspect-ratio: 3 / 4; border-radius: var(--arch); }
    .pic > img, .pic > .ph { width: 100%; height: 100%; object-fit: cover; }
    .frame figcaption { margin-top: 0.75rem; color: var(--muted); font-size: 0.9375rem; font-style: italic; line-height: 1.45; }
    @media (max-width: 599.98px) { .pic { height: 16rem; } .frame .pic { max-width: calc(100vw - 4rem); } }

    /* Huéspedes: libro de visitas en columnas */
    .guests { background: var(--surface); }
    .guestbook { columns: 3 17rem; column-gap: 1.5rem; }
    .guestbook.count-2 { columns: 2 18rem; max-width: 56rem; margin-inline: auto; }
    .guest { display: flex; flex-direction: column; break-inside: avoid; margin: 0 0 1.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: var(--radius-lg); background: var(--bg); }
    .guest blockquote { font-size: 1.0625rem; line-height: 1.65; }
    .guest blockquote::before { content: "“"; display: block; height: 1.75rem; color: var(--secondary-ink); font-family: var(--font-heading); font-size: 3.75rem; line-height: 1; }
    .guest figcaption { display: flex; align-items: center; gap: 0.875rem; margin-top: 1.5rem; }
    .guest .avatar { background: color-mix(in srgb, var(--primary) 18%, var(--bg)); color: var(--primary-ink); font-family: var(--font-heading); font-weight: 400; }
    .guest strong { display: block; font-weight: 700; line-height: 1.3; }
    .guest figcaption span:not(.avatar) { display: block; color: var(--muted); font-size: 0.875rem; font-style: italic; }
    .guestbook.single { columns: auto; max-width: 46rem; margin-inline: auto; }
    .guestbook.single .guest { align-items: center; padding: 0; background: none; text-align: center; }
    .guestbook.single blockquote { font-family: var(--font-heading); font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem); line-height: 1.3; }
    .guestbook.single blockquote::before { height: 2.25rem; font-size: 5rem; }

    /* Preguntas */
    .faqs .container { max-width: 52rem; }
    .faq-list { display: grid; gap: 0.75rem; }
    .faq-item { border-radius: var(--radius); background: var(--surface); }
    .faq-item > summary { padding: 1.25rem 1.25rem 1.25rem 1.5rem; font-family: var(--font-heading); font-size: 1.125rem; line-height: 1.35; }
    .faq-dot { display: grid; place-items: center; flex-shrink: 0; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--bg); color: var(--primary-ink); }
    .faq-dot svg { width: 1.125rem; height: 1.125rem; }
    .faq-answer { padding: 0 4.25rem 1.5rem 1.5rem; color: var(--muted); }
    @media (max-width: 520px) { .faq-answer { padding-right: 1.5rem; } }

    /* Disponibilidad: banda teja con alero */
    .cta { position: relative; margin-top: 1.25rem; padding-block: clamp(4rem, 8vw, 6.5rem); background: var(--secondary); color: var(--on-secondary); text-align: center; }
    .cta::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: -1.1875rem;
      height: 1.25rem;
      background: radial-gradient(circle at 50% 100%, var(--secondary) 0 1.125rem, transparent calc(1.125rem + 1px)) center bottom / 2.25rem 1.25rem repeat-x;
    }
    .cta .container { max-width: 48rem; }
    .cta-title { font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; }
    .cta p { max-width: 36rem; margin: 1.25rem auto 0; font-size: 1.125rem; opacity: 0.9; }
    .cta .actions { justify-content: center; margin-top: 2rem; }
    .btn-invert { background: var(--on-secondary); color: var(--secondary); }
    .btn-invert:hover { background: color-mix(in srgb, var(--on-secondary) 86%, var(--secondary)); }
    .btn-line { border-color: color-mix(in srgb, var(--on-secondary) 55%, transparent); color: var(--on-secondary); }
    .btn-line:hover { border-color: var(--on-secondary); }

    /* Contacto */
    .contact-grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: start; }
    .contact .section-head { margin-bottom: 2rem; }
    .address { display: flex; gap: 0.75rem; font-family: var(--font-heading); font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem); line-height: 1.35; }
    .address svg { width: 1.5rem; height: 1.5rem; margin-top: 0.2rem; color: var(--secondary-ink); flex-shrink: 0; }
    .contact-intro .link-arrow { margin: 1rem 0 0 2.25rem; }
    .contact-cards { display: grid; gap: 1rem; }
    .ccard { padding: clamp(1.5rem, 3vw, 2rem); border-radius: var(--radius-lg); background: var(--surface); }
    .ccard h3 { font-size: 1.375rem; }
    .ccard-lines { display: grid; gap: 0.625rem; margin-top: 1rem; }
    .ccard-lines a { display: inline-flex; align-items: center; gap: 0.625rem; font-weight: 600; overflow-wrap: anywhere; }
    .ccard-lines a:hover { color: var(--primary-ink); text-decoration: underline; text-underline-offset: 3px; }
    .ccard-lines svg { width: 1.125rem; height: 1.125rem; flex-shrink: 0; color: var(--primary-ink); }
    .ccard ul { margin-top: 0.75rem; }
    .ccard li { padding: 0.5rem 0; border-bottom: 1px dashed var(--border); color: var(--muted); }
    .ccard li:last-child { border-bottom: 0; padding-bottom: 0; }
    @media (min-width: 900px) { .contact-grid.has-cards { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 5rem; } }
    @media (min-width: 640px) and (max-width: 899.98px) { .contact-cards { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); } }

    /* Pie */
    .site-footer { padding: clamp(4rem, 8vw, 6rem) 0 2rem; background: var(--deepest); color: var(--on-deep-muted); }
    .footer-top { display: grid; gap: 2.5rem; padding-bottom: 3rem; border-bottom: 1px solid var(--line-deep); }
    .footer-brand { color: var(--on-deep); font-family: var(--font-heading); font-size: clamp(2rem, 1.5rem + 2.2vw, 3.25rem); line-height: 1.05; }
    .footer-brand img { height: 3rem; width: auto; }
    .footer-text { max-width: 30rem; margin-top: 1rem; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; align-content: start; }
    .footer-links a { color: var(--on-deep); font-weight: 600; }
    .footer-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; padding-top: 1.75rem; font-size: 0.875rem; }
    @media (min-width: 820px) { .footer-top { grid-template-columns: minmax(0, 1fr) auto; align-items: end; } }
  </style>
</head>
<body>
  <a class="skip-link" href="#main"><%= t("skip") %></a>

  <%
    // Cabecera de sección: antetítulo, título y entradilla (solo lo que tenga texto)
    function sectionHead(key, extraClass) {
      const h = heading(key);
      if (!h.eyebrow && !h.title && !h.subtitle) return;
  %>
    <div class="section-head <%= extraClass || '' %>">
      <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
      <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
      <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
    </div>
  <% } %>

  <%
    const c = config.contact;
    const showContact = show("contact");
    const hourLines = lines(c.hours);
    const hero = config.hero;
    const showHero = show("hero");
  %>

  <header class="site-header<%= showHero ? '' : ' solid' %>" data-section="brand">
    <div class="container nav">
      <a class="brand" href="#main">
        <% if (config.brand.logo) { %><%- img(config.brand.logo, config.brand.name, { eager: true, sizes: "160px", width: 480 }) %><% } %>
        <% if (config.brand.name || !config.brand.logo) { %><span><%= config.brand.name %></span><% } %>
      </a>
      <%- navLinks({ limit: 4, exclude: ["contact"] }) %>
      <% if (hero.ctaText && showHero) { %>
        <a class="btn btn-primary btn-sm nav-cta" <%- linkAttrs(hero.ctaLink) %>><%= hero.ctaText %></a>
      <% } %>
      <%- mobileMenu({ cta: showHero ? { text: hero.ctaText, href: hero.ctaLink } : undefined }) %>
    </div>
  </header>

  <main id="main">
    <% if (showHero) { const hasMedia = Boolean(hero.backgroundImage); %>
    <section class="hero" id="hero" data-section="hero">
      <% if (hasMedia) { %><div class="hero-media"><%- img(hero.backgroundImage, "", { eager: true, width: 2000 }) %></div><% } %>
      <div class="container">
        <div class="hero-arch">
          <% if (hero.eyebrow) { %><p class="eyebrow rise"><%- icon("mountain", "") %><span><%= hero.eyebrow %></span></p><% } %>
          <% if (hero.title) { %><h1 class="hero-title rise-2<%= hero.title.length > 70 ? ' is-long' : '' %>"><%= hero.title %></h1><% } %>
          <% if (hero.subtitle) { %><p class="hero-sub rise-3"><%= hero.subtitle %></p><% } %>
          <% if (hero.ctaText || hero.secondaryCtaText) { %>
          <div class="actions rise-3">
            <% if (hero.ctaText) { %><a class="btn btn-primary btn-lg" <%- linkAttrs(hero.ctaLink) %>><%= hero.ctaText %></a><% } %>
            <% if (hero.secondaryCtaText) { %><a class="btn btn-outline btn-lg" <%- linkAttrs(hero.secondaryCtaLink) %>><%= hero.secondaryCtaText %></a><% } %>
          </div>
          <% } %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("about")) { const a = config.about; const h = heading("about"); %>
    <section class="section about" id="about" data-section="about">
      <div class="container about-grid<%= a.image ? ' has-media' : '' %>">
        <% if (a.image) { %><div class="about-media"><%- img(a.image, a.heading, { sizes: "(min-width: 900px) 40vw, 100vw", width: 1200 }) %></div><% } %>
        <div class="about-copy">
          <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
          <% if (a.heading) { %><h2 class="about-title"><%= a.heading %></h2><% } %>
          <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
          <% if (a.content) { %><div class="prose"><%- paras(a.content) %></div><% } %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("features")) { %>
    <section class="section amenities" id="features" data-section="features">
      <div class="container">
        <% sectionHead("features") %>
        <ul class="amenity-grid">
          <% config.features.forEach((f) => { %>
            <li class="amenity">
              <span class="amenity-icon"><%- icon(f.icon || "leaf") %></span>
              <% if (f.title) { %><h3><%= f.title %></h3><% } %>
              <% if (f.description) { %><p><%= f.description %></p><% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% } %>

    <% if (show("products")) { const anyImg = config.products.some((p) => p.image); const n = config.products.length; %>
    <section class="section rooms" id="products" data-section="products">
      <div class="container">
        <% sectionHead("products", "center") %>
        <ul class="rooms-grid count-<%= n %><%= anyImg ? '' : ' no-media' %>">
          <% config.products.forEach((p) => { const info = lines(p.description); %>
            <li class="room">
              <% if (anyImg) { %>
              <div class="room-media">
                <%- img(p.image, p.title, { sizes: "(min-width: 1024px) 380px, (min-width: 600px) 50vw, 100vw", width: 1200, placeholder: "bed-double" }) %>
                <% if (p.badge) { %><span class="room-badge"><%= p.badge %></span><% } %>
              </div>
              <% } %>
              <div class="room-body">
                <% if (!anyImg && p.badge) { %><span class="room-badge"><%= p.badge %></span><% } %>
                <% if (p.title) { %><h3><%= p.title %></h3><% } %>
                <% if (info.length) { %>
                  <p class="room-cap"><%- icon("users", "") %><span><%= info[0] %></span></p>
                  <% info.slice(1).forEach((line) => { %><p class="room-note"><%= line %></p><% }) %>
                <% } %>
                <% if (p.price || p.link) { %>
                <div class="room-foot">
                  <% if (p.price) { %><span class="room-price"><%= p.price %></span><% } %>
                  <% if (p.link) { %><a class="btn btn-outline btn-sm" <%- linkAttrs(p.link) %>><%= t("book") %></a><% } %>
                </div>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% } %>

    <% if (show("gallery")) { %>
    <section class="section gallery" id="gallery" data-section="gallery">
      <div class="container"><% sectionHead("gallery") %></div>
      <div class="strip" tabindex="0" role="region" aria-label="<%= heading('gallery').title || t('photosLabel') %>">
        <% config.gallery.forEach((g) => { %>
          <figure class="frame">
            <div class="pic"><%- img(g.image, g.caption, { sizes: "(min-width: 900px) 560px, 80vw", width: 1200 }) %></div>
            <% if (g.caption) { %><figcaption><%= g.caption %></figcaption><% } %>
          </figure>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (show("testimonials")) { const n = config.testimonials.length; %>
    <section class="section guests" id="testimonials" data-section="testimonials">
      <div class="container">
        <% sectionHead("testimonials", "center") %>
        <div class="guestbook<%= n === 1 ? ' single' : (n === 2 || n === 4) ? ' count-2' : '' %>">
          <% config.testimonials.forEach((r) => { %>
            <figure class="guest">
              <% if (r.quote) { %><blockquote><%= r.quote %></blockquote><% } %>
              <% if (r.name || r.role) { %>
              <figcaption>
                <span class="avatar" aria-hidden="true"><% if (r.avatar) { %><%- img(r.avatar, "", { sizes: "48px", width: 480 }) %><% } else { %><%= initials(r.name) %><% } %></span>
                <div><% if (r.name) { %><strong><%= r.name %></strong><% } %><% if (r.role) { %><span><%= r.role %></span><% } %></div>
              </figcaption>
              <% } %>
            </figure>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("faqs")) { %>
    <section class="section faqs" id="faqs" data-section="faqs">
      <div class="container">
        <% sectionHead("faqs", "center") %>
        <div class="faq-list">
          <% config.faqs.forEach((f, i) => { %>
            <details class="faq-item"<%= i === 0 ? " open" : "" %>>
              <summary><span><%= f.question || t("question") %></span><span class="faq-dot"><%- icon("plus", "faq-icon") %></span></summary>
              <% if (f.answer) { %><div class="faq-answer"><%- paras(f.answer) %></div><% } %>
            </details>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("cta")) { const cta = config.cta; const wa = showContact && c.whatsapp; %>
    <section class="cta" id="cta" data-section="cta">
      <div class="container">
        <% if (cta.title) { %><h2 class="cta-title"><%= cta.title %></h2><% } %>
        <% if (cta.text) { %><p><%= cta.text %></p><% } %>
        <% if (cta.buttonText || wa) { %>
        <div class="actions">
          <% if (cta.buttonText) { %><a class="btn btn-lg btn-invert" <%- linkAttrs(cta.buttonLink) %>><%= cta.buttonText %></a><% } %>
          <% if (wa) { %><a class="btn btn-lg btn-line" <%- linkAttrs(waHref(c.whatsapp)) %>><%- icon("message-circle", "") %><%= t("whatsapp") %></a><% } %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (showContact) { const hasBook = Boolean(c.phone || c.email || c.whatsapp); const hasCards = hasBook || hourLines.length > 0; %>
    <section class="section contact" id="contact" data-section="contact">
      <div class="container contact-grid<%= hasCards ? ' has-cards' : '' %>">
        <div class="contact-intro">
          <% sectionHead("contact") %>
          <% if (c.address) { %>
            <p class="address"><%- icon("map-pin", "") %><span><%= c.address %></span></p>
            <a class="link-arrow" <%- linkAttrs(mapsHref(c.address)) %>><%= t("directions") %><%- icon("arrow-up-right", "") %></a>
          <% } %>
        </div>
        <% if (hasCards) { %>
        <div class="contact-cards">
          <% if (hasBook) { %>
          <div class="ccard">
            <h3><%= t("bookings") %></h3>
            <div class="ccard-lines">
              <% if (c.phone) { %><a href="<%= telHref(c.phone) %>"><%- icon("phone", "") %><%= c.phone %></a><% } %>
              <% if (c.whatsapp) { %><a <%- linkAttrs(waHref(c.whatsapp)) %>><%- icon("message-circle", "") %><%= t("writeWhatsapp") %></a><% } %>
              <% if (c.email) { %><a href="<%= mailHref(c.email) %>"><%- icon("mail", "") %><%= c.email %></a><% } %>
            </div>
          </div>
          <% } %>
          <% if (hourLines.length) { %>
          <div class="ccard">
            <h3><%= t("arrivals") %></h3>
            <ul><% hourLines.forEach((line) => { %><li><%= line %></li><% }) %></ul>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>
  </main>

  <% if (show("footer")) { %>
  <footer class="site-footer" id="footer" data-section="footer">
    <div class="container">
      <div class="footer-top">
        <div>
          <p class="footer-brand"><% if (config.brand.logo && !config.brand.name) { %><%- img(config.brand.logo, "", { sizes: "160px", width: 480 }) %><% } else { %><%= config.brand.name %><% } %></p>
          <% if (config.footer.text) { %><p class="footer-text"><%= config.footer.text %></p><% } %>
        </div>
        <% if (config.footer.links.length) { %>
        <nav class="footer-links" aria-label="<%= config.brand.name %>">
          <% config.footer.links.forEach((l) => { %><a <%- linkAttrs(l.url) %>><%= l.label || l.url %></a><% }) %>
        </nav>
        <% } %>
      </div>
      <div class="footer-bottom">
        <p><%- copyright(config.brand.name) %></p>
        <%- madeWith %>
      </div>
    </div>
  </footer>
  <% } %>

  <%- foot %>
</body>
</html>
