<!DOCTYPE html>
<html <%- htmlAttrs %>>
<head>
  <%- head %>
  <style>
    /* Blog y newsletter: revista. Papel claro, tinta y un solo color de acento;
       titulares serif grandes, secciones que abren con un filete grueso como en
       una revista impresa, portada con la foto de apertura y capitular en la
       presentación de la autora. */
    :root {
      --bg: #fbfbf8;
      --surface: #f1f0eb;
      --surface-2: #e6e4dc;
      --text: #17181b;
      --muted: #5c5e64;
      --border: #e0ded6;
      --radius-sm: 3px;
      --radius: 4px;
      --radius-lg: 6px;
      --radius-btn: 999px;
      --container: 1240px;
      --ink: color-mix(in srgb, var(--secondary) 40%, #101114);
      --ink-text: #f3f2ee;
      --ink-muted: rgb(243 242 238 / 0.68);
      --ink-line: rgb(243 242 238 / 0.16);
    }
    html.bi-dark {
      --bg: #121315;
      --surface: #1a1b1e;
      --surface-2: #24262a;
      --text: #ecebe6;
      --muted: #a5a7ad;
      --border: #2c2e33;
      --ink: color-mix(in srgb, var(--secondary) 20%, #0a0a0c);
    }

    body { font-size: 1.0625rem; }
    h1, h2, h3, .title { font-weight: 450; letter-spacing: -0.02em; }
    .title { font-size: clamp(2.25rem, 1.4rem + 3vw, 4rem); line-height: 1.02; }

    /* Antetítulo: volanta de revista en el color de acento */
    .eyebrow {
      margin-bottom: 0.75rem;
      color: var(--primary-ink);
      font-size: 0.9375rem;
      font-weight: 600;
      letter-spacing: 0;
      text-transform: none;
    }

    /* Apertura de sección: filete grueso, título y entradilla a la derecha */
    .opener { display: grid; gap: 1rem 3rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); padding-top: 1.25rem; border-top: 3px solid var(--text); }
    .opener .lead { margin-top: 0; max-width: 30rem; }
    @media (min-width: 900px) {
      .opener { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; }
      .opener > .lead { justify-self: end; }
    }

    /* Cabecera */
    .site-header { border-bottom-color: var(--border); }
    .brand { font-size: 1.875rem; font-style: italic; font-weight: 500; letter-spacing: -0.03em; }
    .nav-links a { color: var(--text); opacity: 0.72; }
    .nav-links a:hover { opacity: 1; }

    /* Portada: titular a toda anchura y foto de apertura */
    .hero { padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3.5rem, 7vw, 6rem); }
    .hero-title {
      max-width: 15ch;
      font-size: clamp(3rem, 1rem + 6.4vw, 7.5rem);
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: -0.035em;
    }
    .hero-title.is-long { max-width: 22ch; font-size: clamp(2.5rem, 1.2rem + 3.8vw, 5rem); line-height: 1.02; }
    .hero-row { display: grid; gap: 2rem 3rem; margin-top: clamp(2rem, 4vw, 3.5rem); padding-top: clamp(1.5rem, 3vw, 2rem); border-top: 1px solid var(--border); }
    .hero-figure { aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; background: var(--surface-2); }
    .hero-figure img { width: 100%; height: 100%; object-fit: cover; }
    .hero-side { display: grid; gap: 1.75rem; align-content: start; }
    .hero-sub { font-family: var(--font-heading); font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); font-style: italic; line-height: 1.4; }
    .hero-side .actions { flex-direction: column; align-items: stretch; }
    .hero-row.text-only .hero-side { max-width: 40rem; }
    .hero-row.text-only .hero-side .actions { flex-direction: row; align-items: center; }
    @media (min-width: 900px) {
      .hero-row:not(.text-only) { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
      .hero-side .actions .btn { justify-content: center; }
    }
    @media (max-width: 899px) { .hero-side .actions { flex-direction: row; align-items: center; } }

    /* Artículos */
    .lead-story { display: grid; gap: 1.5rem 3rem; }
    .story-media { display: block; aspect-ratio: 3 / 2; border-radius: var(--radius); overflow: hidden; background: var(--surface-2); }
    .story-media > img, .story-media > .ph { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
    a.story-media:hover > img { transform: scale(1.03); }
    .story-body { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
    .story-kicker { color: var(--primary-ink); font-size: 0.875rem; font-weight: 600; }
    .story h3 { font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem); line-height: 1.15; }
    .story h3 a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.4s var(--ease); }
    .story h3 a:hover { background-size: 100% 1px; }
    .story p { color: var(--muted); }
    .story-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; margin-top: auto; padding-top: 0.25rem; font-size: 0.875rem; color: var(--muted); }
    .story-meta .time { display: inline-flex; align-items: center; gap: 0.375rem; }
    .story-meta .time svg { width: 0.95rem; height: 0.95rem; }
    .story-meta a { color: var(--text); font-weight: 600; text-decoration: underline; text-decoration-color: var(--primary); text-decoration-thickness: 2px; text-underline-offset: 4px; }
    .lead-story h3 { font-size: clamp(1.875rem, 1.2rem + 2.2vw, 3.25rem); line-height: 1.05; letter-spacing: -0.03em; }
    .lead-story p { max-width: 40rem; font-size: 1.125rem; }
    .lead-story .story-media { aspect-ratio: 4 / 3; }
    @media (min-width: 900px) {
      .lead-story.has-media { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; }
      .lead-story .story-body { padding-block: 1rem; }
    }
    .stories { display: grid; gap: clamp(2.5rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem); margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: clamp(2.5rem, 5vw, 3.5rem); border-top: 1px solid var(--border); }
    .stories .story { display: flex; flex-direction: column; gap: 1.125rem; }
    @media (min-width: 640px) and (max-width: 999px) {
      .stories { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .stories .story:last-child:nth-child(odd) { grid-column: 1 / -1; }
      .stories .story:last-child:nth-child(odd).has-media { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; align-items: center; }
    }
    @media (min-width: 1000px) {
      .stories { grid-template-columns: repeat(6, minmax(0, 1fr)); }
      .stories .story { grid-column: span 2; }
      .stories .story.w3 { grid-column: span 3; }
      .stories .story.w6 { grid-column: 1 / -1; }
      .stories .story.w6.has-media { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3rem; align-items: center; }
      .stories .story.w3 .story-media { aspect-ratio: 16 / 9; }
    }
    /* Sin fotos: índice de revista */
    .stories.text-only .story { padding-top: 1.25rem; border-top: 1px solid var(--text); }
    .lead-story:not(.has-media) h3 { max-width: 22ch; }

    /* La autora */
    .author { background: var(--surface); }
    .author-grid { display: grid; gap: 2.5rem clamp(2.5rem, 6vw, 6rem); align-items: center; }
    .author-photo { max-width: 26rem; aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; }
    .author-photo img { width: 100%; height: 100%; object-fit: cover; }
    .author-title { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.5rem); line-height: 1.05; letter-spacing: -0.03em; }
    .author .lead { margin-top: 1rem; }
    .author .prose { margin-top: 1.75rem; max-width: 38rem; font-size: 1.125rem; line-height: 1.7; }
    .author .prose p:first-child::first-letter {
      float: left;
      margin: 0.06em 0.12em 0 0;
      color: var(--primary-ink);
      font-family: var(--font-heading);
      font-size: 4.1em;
      font-weight: 500;
      line-height: 0.8;
    }
    @media (min-width: 900px) { .author-grid.has-photo { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
    @media (max-width: 899px) { .author-photo { max-width: none; aspect-ratio: 3 / 2; } }

    /* Instagram */
    .ig { --cols: 6; --c: var(--cols); --gap: 0.375rem; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap); }
    .ig-item { position: relative; flex: 0 0 auto; width: calc((100% - (var(--c) - 1) * var(--gap)) / var(--c)); max-width: 24rem; aspect-ratio: 1; overflow: hidden; background: var(--surface-2); }
    .ig-item > img, .ig-item > .ph { width: 100%; height: 100%; object-fit: cover; }
    .ig-item figcaption {
      position: absolute;
      inset: auto 0 0;
      padding: 2rem 0.75rem 0.625rem;
      background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent);
      color: #fff;
      font-size: 0.8125rem;
      line-height: 1.35;
      opacity: 0;
      transition: opacity 0.3s var(--ease);
    }
    .ig-item:hover figcaption { opacity: 1; }
    .ig-item.no-img figcaption { position: absolute; inset: 0; display: grid; place-items: end start; background: none; color: var(--muted); opacity: 1; }
    @media (max-width: 899px) { .ig { --c: min(var(--cols), 3); } }
    @media (hover: none) { .ig-item figcaption { display: none; } .ig-item.no-img figcaption { display: grid; } }

    /* Vídeo */
    .film { background: var(--ink); color: var(--ink-text); }
    .film .opener { border-top-color: var(--ink-text); }
    .film .eyebrow { color: color-mix(in srgb, var(--primary-on-dark) 85%, #fff); }
    .film .lead { color: var(--ink-muted); }
    .film .video-frame { border-radius: var(--radius); }

    /* Lectores */
    .letters { display: grid; gap: 1.5rem; }
    .letters.c1 { max-width: 52rem; }
    .letter { display: flex; flex-direction: column; gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2rem); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg); }
    .letter blockquote { flex: 1; font-family: var(--font-heading); font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem); font-style: italic; line-height: 1.4; }
    .letters.c1 .letter blockquote { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem); }
    .letter figcaption { display: flex; align-items: center; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.9375rem; }
    .letter strong { display: block; font-weight: 600; }
    .letter .who { color: var(--muted); }
    @media (min-width: 640px) and (max-width: 999px) {
      .letters:not(.c1) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .letters .letter:last-child:nth-child(odd) { grid-column: 1 / -1; }
    }
    @media (min-width: 1000px) {
      .letters:not(.c1) { grid-template-columns: repeat(6, minmax(0, 1fr)); }
      .letters .letter { grid-column: span 2; }
      .letters .letter.w3 { grid-column: span 3; }
      .letters .letter.w6 { grid-column: 1 / -1; }
    }

    /* Newsletter */
    .subscribe { background: var(--primary); color: var(--on-primary); }
    .subscribe-grid { display: grid; gap: 2rem 4rem; align-items: end; }
    .subscribe-title { max-width: 13ch; font-size: clamp(2.75rem, 1.2rem + 5.6vw, 6.5rem); font-style: italic; font-weight: 400; line-height: 0.98; letter-spacing: -0.035em; }
    .subscribe-side { display: grid; gap: 1.75rem; justify-items: start; }
    .subscribe-side p { max-width: 30rem; font-size: 1.125rem; line-height: 1.55; }
    .btn-invert { background: var(--on-primary); color: var(--primary); }
    .btn-invert:hover { background: color-mix(in srgb, var(--on-primary) 86%, var(--primary)); }
    @media (min-width: 900px) { .subscribe-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }

    /* Contacto */
    .contact-grid { display: grid; gap: 2rem 4rem; padding-top: 1.25rem; border-top: 3px solid var(--text); }
    .contact-grid .title { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.25rem); }
    .contact-grid .lead { margin-top: 1rem; max-width: 30rem; }
    .contact-list { display: grid; align-content: start; }
    .contact-list div { display: grid; gap: 0.25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--border); }
    .contact-list div:first-child { padding-top: 0.5rem; }
    .contact-list dt { color: var(--muted); font-size: 0.875rem; font-weight: 600; }
    .contact-list dd { font-family: var(--font-heading); font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem); line-height: 1.3; overflow-wrap: anywhere; }
    .contact-list dd a:hover { color: var(--primary-ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
    .contact-list ul { font-family: var(--font-body); font-size: 1.0625rem; }
    @media (min-width: 900px) { .contact-grid { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); } }

    /* Pie */
    .site-footer { padding: clamp(3.5rem, 7vw, 5.5rem) 0 2rem; background: var(--ink); color: var(--ink-muted); }
    .footer-top { display: grid; gap: 1.5rem 4rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--ink-line); }
    .footer-mast { color: var(--ink-text); font-family: var(--font-heading); font-size: clamp(3.5rem, 2rem + 6vw, 8rem); font-style: italic; font-weight: 400; line-height: 0.9; letter-spacing: -0.04em; overflow-wrap: anywhere; }
    .footer-mast.small { font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem); line-height: 1; }
    .footer-mast img { width: auto; height: clamp(3rem, 7vw, 5rem); }
    .footer-text { max-width: 24rem; color: var(--ink-text); }
    .footer-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; margin-top: 1.5rem; }
    .footer-links a { color: var(--ink-text); font-weight: 500; }
    .footer-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; padding-top: 1.75rem; font-size: 0.875rem; }
    @media (min-width: 900px) { .footer-top { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); align-items: end; } }
  </style>
</head>
<body>
  <a class="skip-link" href="#main"><%= t("skip") %></a>

  <%
    // Apertura de sección: filete, volanta, título y entradilla
    function opener(key) {
      const h = heading(key);
      if (!h.eyebrow && !h.title && !h.subtitle) return;
  %>
    <div class="opener">
      <div>
        <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
        <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
      </div>
      <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
    </div>
  <% } %>

  <%
    const c = config.contact;
    const hero = config.hero;
    const cta = config.cta;
    const hourLines = lines(c.hours);
    const headerCta = show("cta") && cta.buttonText
      ? { text: cta.buttonText, href: cta.buttonLink || "#cta" }
      : show("hero") && hero.ctaText ? { text: hero.ctaText, href: hero.ctaLink } : null;
    // Botón de la cabecera: corto aunque el de la newsletter sea largo
    const headerCtaText = headerCta ? (show("hero") && hero.ctaText ? hero.ctaText : headerCta.text) : "";
    // Ancho de cada elemento en una rejilla de 6 columnas (filas de 3) sin huérfanos:
    // si sobran 2, la última fila va a medias; si sobra 1, las 4 últimas van de 2 en 2
    const span = (i, n) => {
      const r = n % 3;
      if (n === 1) return "w6";
      if (r === 2 && i >= n - 2) return "w3";
      if (r === 1 && i >= n - 4) return "w3";
      return "";
    };
  %>

  <header class="site-header" data-section="brand">
    <div class="container nav">
      <a class="brand" href="#main">
        <% if (config.brand.logo) { %><%- img(config.brand.logo, config.brand.name, { eager: true, sizes: "160px", width: 480 }) %><% } %>
        <% if (config.brand.name || !config.brand.logo) { %><span><%= config.brand.name %></span><% } %>
      </a>
      <%- navLinks({ limit: 5, exclude: ["video"] }) %>
      <% if (headerCta) { %><a class="btn btn-primary btn-sm nav-cta" <%- linkAttrs(headerCta.href) %>><%= headerCtaText %></a><% } %>
      <%- mobileMenu({ cta: headerCta ? { text: headerCtaText, href: headerCta.href } : undefined }) %>
    </div>
  </header>

  <main id="main">
    <% if (show("hero")) { const longTitle = hero.title.length > 60; const withImage = Boolean(hero.backgroundImage); %>
    <section class="hero" id="hero" data-section="hero">
      <div class="container">
        <% if (hero.eyebrow) { %><p class="eyebrow rise"><%= hero.eyebrow %></p><% } %>
        <% if (hero.title) { %><h1 class="hero-title rise-2<%= longTitle ? ' is-long' : '' %>"><%= hero.title %></h1><% } %>
        <% if (withImage || hero.subtitle || hero.ctaText || hero.secondaryCtaText) { %>
        <div class="hero-row rise-3<%= withImage ? '' : ' text-only' %>">
          <% if (withImage) { %><div class="hero-figure"><%- img(hero.backgroundImage, "", { eager: true, sizes: "(min-width: 900px) 800px, 100vw", width: 1600 }) %></div><% } %>
          <% if (hero.subtitle || hero.ctaText || hero.secondaryCtaText) { %>
          <div class="hero-side">
            <% if (hero.subtitle) { %><p class="hero-sub"><%= hero.subtitle %></p><% } %>
            <% if (hero.ctaText || hero.secondaryCtaText) { %>
            <div class="actions">
              <% if (hero.ctaText) { %><a class="btn btn-lg btn-primary" <%- linkAttrs(hero.ctaLink) %>><%= hero.ctaText %></a><% } %>
              <% if (hero.secondaryCtaText) { %><a class="btn btn-lg btn-outline" <%- linkAttrs(hero.secondaryCtaLink) %>><%= hero.secondaryCtaText %></a><% } %>
            </div>
            <% } %>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (show("products")) {
      const posts = config.products;
      const withMedia = posts.some((p) => p.image);
      const [first, ...rest] = posts;
      function story(p, cls, sizes) {
    %>
      <article class="story <%= cls %><%= withMedia ? ' has-media' : '' %>">
        <% if (withMedia) { %>
          <% if (p.link) { %><a class="story-media" <%- linkAttrs(p.link) %> tabindex="-1" aria-hidden="true"><%- img(p.image, "", { sizes, width: 1600, placeholder: "book-open" }) %></a>
          <% } else { %><div class="story-media"><%- img(p.image, p.title, { sizes, width: 1600, placeholder: "book-open" }) %></div><% } %>
        <% } %>
        <div class="story-body">
          <% if (p.badge) { %><p class="story-kicker"><%= p.badge %></p><% } %>
          <% if (p.title) { %><h3><% if (p.link) { %><a <%- linkAttrs(p.link) %>><%= p.title %></a><% } else { %><%= p.title %><% } %></h3><% } %>
          <% if (p.description) { %><p><%= p.description %></p><% } %>
          <% if (p.price || p.link) { %>
          <div class="story-meta">
            <% if (p.price) { %><span class="time"><%- icon("clock") %><%= p.price %></span><% } %>
            <% if (p.link) { %><a <%- linkAttrs(p.link) %>><%= t("read") %></a><% } %>
          </div>
          <% } %>
        </div>
      </article>
    <% } %>
    <section class="section" id="products" data-section="products">
      <div class="container">
        <% opener("products") %>
        <% story(first, "lead-story", "(min-width: 900px) 700px, 100vw") %>
        <% if (rest.length) { %>
        <div class="stories<%= withMedia ? '' : ' text-only' %>">
          <% rest.forEach((p, i) => { story(p, span(i, rest.length), "(min-width: 1000px) 400px, (min-width: 640px) 50vw, 100vw") }) %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (show("about")) { const a = config.about; const h = heading("about"); %>
    <section class="section author" id="about" data-section="about">
      <div class="container author-grid<%= a.image ? ' has-photo' : '' %>">
        <% if (a.image) { %><div class="author-photo"><%- img(a.image, "", { sizes: "(min-width: 900px) 416px, 100vw", width: 1200 }) %></div><% } %>
        <div>
          <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
          <% if (a.heading) { %><h2 class="author-title"><%= a.heading %></h2><% } %>
          <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
          <% if (a.content) { %><div class="prose"><%- paras(a.content) %></div><% } %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("gallery")) {
      const g = config.gallery;
      const n = g.length;
      // Columnas que dejan filas completas siempre que se pueda
      const cols = n <= 6 ? n : [6, 4, 5, 3].find((k) => n % k === 0) || 6;
    %>
    <section class="section" id="gallery" data-section="gallery">
      <div class="container">
        <% opener("gallery") %>
        <div class="ig" style="--cols: <%= cols %>">
          <% g.forEach((item) => { %>
            <figure class="ig-item<%= item.image ? '' : ' no-img' %>">
              <%- img(item.image, item.caption, { sizes: "(min-width: 900px) 200px, 33vw", width: 800 }) %>
              <% if (item.caption) { %><figcaption><%= item.caption %></figcaption><% } %>
            </figure>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("video")) { const h = heading("video"); %>
    <section class="section film" id="video" data-section="video">
      <div class="container">
        <% opener("video") %>
        <%- video(config.video.url, config.video.thumbnail, h.title || sectionName("video")) %>
      </div>
    </section>
    <% } %>

    <% if (show("testimonials")) { const list = config.testimonials; const n = list.length; const cls = n === 1 ? "c1" : ""; %>
    <section class="section" id="testimonials" data-section="testimonials">
      <div class="container">
        <% opener("testimonials") %>
        <div class="letters <%= cls %>">
          <% list.forEach((r, i) => { %>
            <figure class="letter <%= n > 1 ? span(i, n) : '' %>">
              <% if (r.quote) { %><blockquote>“<%= r.quote %>”</blockquote><% } %>
              <% if (r.name || r.role) { %>
              <figcaption>
                <% if (r.avatar) { %><span class="avatar"><%- img(r.avatar, "", { sizes: "48px", width: 480 }) %></span><% } %>
                <span><% if (r.name) { %><strong><%= r.name %></strong><% } %><% if (r.role) { %><span class="who"><%= r.role %></span><% } %></span>
              </figcaption>
              <% } %>
            </figure>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (show("cta")) { %>
    <section class="section subscribe" id="cta" data-section="cta">
      <div class="container subscribe-grid">
        <% if (cta.title) { %><h2 class="subscribe-title"><%= cta.title %></h2><% } %>
        <% if (cta.text || cta.buttonText) { %>
        <div class="subscribe-side">
          <% if (cta.text) { %><p><%= cta.text %></p><% } %>
          <% if (cta.buttonText) { %><a class="btn btn-lg btn-invert" <%- linkAttrs(cta.buttonLink) %>><%- icon("mail") %><%= cta.buttonText %></a><% } %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (show("contact")) { const h = heading("contact"); %>
    <section class="section" id="contact" data-section="contact">
      <div class="container">
        <div class="contact-grid">
          <div>
            <% if (h.eyebrow) { %><p class="eyebrow"><%= h.eyebrow %></p><% } %>
            <% if (h.title) { %><h2 class="title"><%= h.title %></h2><% } %>
            <% if (h.subtitle) { %><p class="lead"><%= h.subtitle %></p><% } %>
          </div>
          <dl class="contact-list">
            <% if (c.email) { %><div><dt><%= t("email") %></dt><dd><a href="<%= mailHref(c.email) || '#contact' %>"><%= c.email %></a></dd></div><% } %>
            <% if (c.phone) { %><div><dt><%= t("phone") %></dt><dd><a href="<%= telHref(c.phone) %>"><%= c.phone %></a></dd></div><% } %>
            <% if (c.whatsapp) { %><div><dt><%= t("whatsapp") %></dt><dd><a <%- linkAttrs(waHref(c.whatsapp)) %>><%= c.whatsapp %></a></dd></div><% } %>
            <% if (c.address) { %><div><dt><%= t("address") %></dt><dd><a <%- linkAttrs(mapsHref(c.address)) %>><%= c.address %></a></dd></div><% } %>
            <% if (hourLines.length) { %><div><dt><%= t("hours") %></dt><dd><ul><% hourLines.forEach((line) => { %><li><%= line %></li><% }) %></ul></dd></div><% } %>
          </dl>
        </div>
      </div>
    </section>
    <% } %>
  </main>

  <% if (show("footer")) { const name = config.brand.name.trim(); %>
  <footer class="site-footer" id="footer" data-section="footer">
    <div class="container">
      <div class="footer-top">
        <p class="footer-mast<%= name.length > 14 ? ' small' : '' %>"><% if (config.brand.logo && !name) { %><%- img(config.brand.logo, "", { sizes: "200px", width: 480 }) %><% } else { %><%= name %><% } %></p>
        <% if (config.footer.text || config.footer.links.length) { %>
        <div>
          <% if (config.footer.text) { %><p class="footer-text"><%= config.footer.text %></p><% } %>
          <% if (config.footer.links.length) { %>
          <nav class="footer-links" aria-label="<%= name || t('menu') %>">
            <% config.footer.links.forEach((l) => { %><a <%- linkAttrs(l.url) %>><%= l.label || l.url %></a><% }) %>
          </nav>
          <% } %>
        </div>
        <% } %>
      </div>
      <div class="footer-bottom">
        <p><%- copyright(name) %></p>
        <%- madeWith %>
      </div>
    </div>
  </footer>
  <% } %>

  <%- foot %>
</body>
</html>
