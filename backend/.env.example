# Copia este archivo a backend/.env y ajusta los valores.

# development | production
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/buildit

# Obligatorio. Mínimo 32 caracteres aleatorios. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión (formato de jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d

# Orígenes externos autorizados a llamar a la API, separados por comas.
# Vacío = solo el mismo origen (lo normal: proxy de Vite en desarrollo y
# frontend servido por el backend en producción).
CORS_ORIGINS=

# Límite de intentos de login/registro por IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Proxies de confianza para sacar la IP real del cliente de X-Forwarded-For
# (setting "trust proxy" de Express). Vacío o false = ninguno (desarrollo).
# En producción detrás de cloudflared pon la IP del proxy, p. ej. 10.10.10.1;
# sin ella los límites por IP tratan a todos los usuarios como uno solo.
# También admite "loopback", varias IPs/subredes separadas por comas o un número
# de saltos. Evita "true": permite falsear la IP y saltarse los límites.
TRUST_PROXY=
